// The people of Strata Zero: who works where, when, and what they say.
// Hours are minutes of the day; an end before its start wraps past midnight.
People(
    professions: [
        Profession(id: "shopkeeper", label: "shopkeeper", works_at: [Shop, Market, Pawn, Megablock],
            hours: Day(open: 540, close: 1200), staff: (1, 2),
            leisure: [(NoodleBar, 0.3)],
            lines: ["Browse all you like. Touch with money.",
                    "The sign says open. The door says otherwise after eight.",
                    "Everything's got a price. Yours is on the tag."]),
        Profession(id: "noodle_cook", label: "noodle cook", works_at: [NoodleBar, Megablock],
            hours: Day(open: 1020, close: 180), staff: (2, 2),
            lines: ["Broth's been going since Tuesday. That's the secret.",
                    "Sit. Eat. Talk after.",
                    "Night shift pays in soup."]),
        Profession(id: "barkeep", label: "barkeep", works_at: [Bar, Club],
            hours: Day(open: 1200, close: 300), staff: (2, 3),
            lines: ["The ice is clean. The glasses, mostly.",
                    "You drinking or renting the stool?",
                    "Tab's closed. Everybody's tab is closed."]),
        Profession(id: "corp_drone", label: "corp drone", works_at: [Office, CorpTower],
            hours: Day(open: 480, close: 1080), staff: (6, 10),
            leisure: [(Bar, 0.4), (Strip, 0.15)], car_nudge: 0.6,
            lines: ["Badge, lanyard, blood pressure. The whole package.",
                    "I have a meeting in a meeting.",
                    "Don't ask what we make. I stopped."]),
        Profession(id: "line_worker", label: "line worker", works_at: [Factory, Warehouse, Depot],
            hours: Shifts([(360, 840), (840, 1320), (1320, 360)]), staff: (2, 4),
            leisure: [(NoodleBar, 0.5), (Strip, 0.1)], car_nudge: 0.1,
            lines: ["Twelve hours on, the rest is noise.",
                    "The belt doesn't stop. Neither do I.",
                    "You smell that? That's the shift."]),
        Profession(id: "courier", label: "courier", works_at: [Depot],
            hours: Day(open: 480, close: 1200), staff: (2, 3),
            lines: ["Package says no questions. I say no questions.",
                    "Fast is a price. Faster is a bigger one.",
                    "Three districts an hour. Legs are the engine."]),
        // Back-room docs keep night hours.
        Profession(id: "ripperdoc", label: "ripperdoc", works_at: [Clinic],
            hours: Day(open: 1080, close: 240), staff: (1, 1), car_nudge: 0.4,
            lines: ["Anaesthetic's extra. Regret's free.",
                    "I can put it in. Getting it out is a different ticket.",
                    "Clean hands, cleaner chrome."]),
        Profession(id: "sex_worker", label: "sex worker",
            hours: Beat(from: 1260, to: 300), staff: (4, 8), tint: Some(Magenta),
            lines: ["Looking or buying? Both cost.",
                    "The hotel's got hourly. So do I.",
                    "Keep walking if it's just the view."]),
        Profession(id: "fixer", label: "fixer",
            hours: Beat(from: 1080, to: 240), staff: (1, 2), tint: Some(Amber),
            leisure: [(Bar, 1.0)], car_nudge: 0.3,
            lines: ["I know a guy. The guy knows a guy. You know me.",
                    "Work finds people. I just introduce them.",
                    "Everything's a job if you're hungry enough."]),
        Profession(id: "door_muscle", label: "door muscle", works_at: [CorpTower, Office, Club],
            hours: Shifts([(420, 1140), (1140, 420)]), staff: (1, 1), tint: Some(Red),
            night_line: Some("Not tonight. Not with that face."),
            lines: ["List's closed.",
                    "Step back. Breathe. Try again tomorrow.",
                    "Nobody's in. That includes you."]),
        Profession(id: "monk", label: "monk", works_at: [Temple],
            hours: Day(open: 360, close: 1140), staff: (1, 2),
            lines: ["The city prays with its lights on.",
                    "Sit a while. The slab won't move without you.",
                    "Nothing here is for sale. That bothers people."]),
        Profession(id: "ganger", label: "ganger",
            hours: Beat(from: 1200, to: 240), staff: (3, 5), tint: Some(Green),
            leisure: [(Strip, 0.2)], car_nudge: -0.2,
            lines: ["Wrong block, chummer.",
                    "Say it again. Slower.",
                    "This corner's got an owner. You're looking at him."]),
    ],
)
