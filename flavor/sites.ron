// Venue types: how a kind of building is laid out, as data. The Rust never names a type, so
// a new type is a change to this file. A type `builds` the building kinds laid out as it
// (none for a type that stands only on its own frame) and gives a building's floors by role:
// `below` from -1 down, `ground` at 0, `top` on the highest floors (lowest first) and
// `middle` repeated to fill between. Its own `frame` is the building it stands in when no
// city building gives one: a footprint in city tiles, its top level, `doors` along its sides
// (`at` is footprint tiles from the side's start), the Skyways door on level `bridge`, a door
// onto the roof, and whether -1 reaches the Undercity.
// `zones` run public first; a zone's rank is its place in the list. A `Border` is the lock
// between two zones, outer first: a `Card` reader or a `Keypad`, `always` locked or locked only
// for a mission, `one_way` when it opens without a key from the inner side, and the `ways`
// past it (`Card`, `Code`, `Keyjack`, `Net`, `Force`, `Talk`), two or more. A card lock takes
// `Card` and neither `Code` nor `Keyjack`; a keypad takes `Code`.
// A level's `bands` are strips across it, front (the first street door's side) to back, each
// in one zone: its `share` is percent of the depth (a level's shares sum to 100), its `rooms`
// are laid in order, then its `fill` room until the band is used, and `doors` is how many
// doors cross its border with the band in front. `scale` is percent of the frame's width and
// height, over 100 (up to 200) only below -1; `spine` is how the corridor runs (`Straight`,
// `Bent`, `Ring`, `Hall`, or `Any` for the level's seed to pick). `pieces` names set pieces.
// `rooms` are the type's rooms by name: a generic `kind`, a size range ((least width, least
// height), (most width, most height)), `private` for a locked room, its furniture and the
// stations people work at. `pieces` are set pieces of fixed shape: a `Ramp`, a `Track` along
// the far side with its platform, a `GateLine` of turnstiles across the level's first border.
// `links` move you between levels: a `kind`, the zone its landings open into, the levels it
// `serves` (`All`, `Roles([...])` by role name, `Levels([...])` by number), a lift's `cards`
// as (role, zone) where it asks for that zone's card, `dir` (`Up` or `Down` for one way) and
// `alight: Ends` for a stair you can leave only at its ends. `crawls_in` come in from a
// stratum and out in a zone. `objectives` name a room, on a level of the role in `level` when
// one is given. `security` is a mission's layer per size: guard weights per zone, and ranges
// of cameras, turrets (in `turret_zones`) and containers.
// `sizes` is what a mission of each size keeps: floors, locks between a way in and its
// objective, ways in at least, and guards. `crawl_tech` is the Tech a crawl's grille wants.
// Sizes and security are first guesses, to tune by playing.
Sites(
    crawl_tech: 6,
    sizes: [
        Size(size: Small,  floors: (2, 3), locks: (2, 2), ways_in: 2, guards: (6, 10)),
        Size(size: Medium, floors: (4, 6), locks: (3, 3), ways_in: 3, guards: (12, 20)),
        Size(size: Large,  floors: (6, 9), locks: (4, 5), ways_in: 4, guards: (25, 40)),
    ],
    types: [
        Type(
            id: "hotel",
            name: "hotel",
            builds: [Hotel],
            frame: Frame(kind: Hotel, footprint: (15, 9), top: 6, undercity: true, roof: true, bridge: Some(3),
                doors: [Door(stratum: Street, side: S, at: 5), Door(stratum: Street, side: E, at: 4),
                        Door(stratum: Skyways, side: N, at: 7), Door(stratum: Undercity, side: W, at: 3)]),
            zones: ["public", "guest", "staff", "secure"],
            borders: [
                Border(zones: ("public", "guest"), lock: Card, ways: [Card, Net, Talk, Force]),
                Border(zones: ("public", "staff"), lock: Card, always: true, ways: [Card, Net, Talk, Force]),
                Border(zones: ("guest", "staff"), lock: Card, always: true, ways: [Card, Net, Talk, Force]),
                Border(zones: ("staff", "secure"), lock: Keypad, always: true, one_way: true, ways: [Code, Keyjack, Net, Force]),
                Border(zones: ("guest", "secure"), lock: Keypad, always: true, ways: [Code, Keyjack, Net, Force]),
            ],
            levels: Levels(
                below: [
                    Level(name: "car park", bands: [Band(zone: "public", share: 15, rooms: ["lift lobby"]),
                                                    Band(zone: "staff", share: 55, rooms: ["car park"]),
                                                    Band(zone: "secure", share: 30, rooms: ["security office"])]),
                    Level(name: "service", bands: [Band(zone: "staff", share: 100, rooms: ["kitchen", "laundry", "lockers"])]),
                ],
                ground: Level(name: "lobby", bands: [Band(zone: "public", share: 60, rooms: ["reception", "bar"]),
                                                     Band(zone: "staff", share: 40, rooms: ["back office"])]),
                middle: Some(Level(name: "guest floor", spine: Any, bands: [
                    Band(zone: "public", share: 15, rooms: ["lift lobby"]),
                    Band(zone: "guest", share: 65, rooms: [], fill: Some("guest room")),
                    Band(zone: "staff", share: 20, rooms: ["linen room"])])),
                top: [Level(name: "penthouse", bands: [Band(zone: "guest", share: 30, rooms: ["foyer"]),
                                                      Band(zone: "secure", share: 70, rooms: ["lounge", "office"])])],
            ),
            rooms: [
                Room(name: "reception", kind: Lobby, size: ((8, 6), (14, 10)), furniture: [Counter], stations: [Reception]),
                Room(name: "bar", kind: Bar, size: ((6, 5), (12, 8)), furniture: [Counter, Stool, Table], stations: [Bar]),
                Room(name: "back office", kind: Office, size: ((4, 4), (6, 6)), private: true, furniture: [Desk], stations: [Desk]),
                Room(name: "lift lobby", kind: Lobby, size: ((4, 3), (8, 6))),
                Room(name: "car park", kind: CarPark, size: ((12, 8), (30, 16))),
                Room(name: "security office", kind: Office, size: ((4, 4), (7, 6)), private: true, furniture: [Desk, Machine], stations: [Desk]),
                Room(name: "kitchen", kind: Kitchen, size: ((6, 4), (10, 8)), furniture: [Counter, Machine], stations: [Machine]),
                Room(name: "laundry", kind: Laundry, size: ((4, 4), (8, 6)), furniture: [Machine], stations: [Machine]),
                Room(name: "lockers", kind: Lockers, size: ((4, 3), (6, 5)), furniture: [Locker, Bench]),
                Room(name: "guest room", kind: HotelRoom, size: ((4, 4), (6, 6)), private: true, furniture: [Bed]),
                Room(name: "linen room", kind: Storage, size: ((3, 3), (5, 4)), furniture: [Shelf], stations: [Shelf]),
                Room(name: "foyer", kind: Lobby, size: ((4, 4), (8, 6))),
                Room(name: "lounge", kind: Suite, size: ((6, 5), (12, 8)), furniture: [Couch, Table]),
                Room(name: "office", kind: Office, size: ((4, 4), (6, 6)), private: true, furniture: [Desk], stations: [Desk]),
            ],
            links: [
                Link(name: "guest lift", kind: Lift, zone: "public", serves: Roles(["car park", "lobby", "guest floor", "penthouse"]),
                     cards: [("penthouse", "secure")]),
                Link(name: "service lift", kind: Lift, zone: "staff", serves: Roles(["car park", "service", "lobby", "guest floor"])),
                Link(name: "service stair", kind: Stair, zone: "staff", serves: All),
                Link(name: "grand stair", kind: Stair, zone: "public", serves: Levels([0, 1])),
                Link(name: "riser", kind: Crawl, zone: "staff", serves: All),
            ],
            crawls_in: [Crawl(stratum: Heights, zone: "staff"), Crawl(stratum: Undercity, zone: "staff")],
            objectives: [Objective(id: "safe", name: "the penthouse safe", room: "office", level: Some("penthouse"))],
            security: [
                Security(size: Small, guards: [("staff", 1), ("secure", 2)], cameras: (2, 4), turrets: (0, 0),
                         containers: (1, 2)),
                Security(size: Medium, guards: [("public", 1), ("guest", 1), ("staff", 2), ("secure", 3)],
                         cameras: (4, 8), turrets: (0, 1), turret_zones: ["secure"], containers: (2, 4)),
                Security(size: Large, guards: [("public", 2), ("guest", 2), ("staff", 3), ("secure", 4)],
                         cameras: (8, 14), turrets: (2, 4), turret_zones: ["secure"], containers: (3, 6)),
            ],
        ),
        Type(
            id: "office",
            name: "office",
            builds: [Office],
            frame: Frame(kind: Office, footprint: (12, 10), top: 8, undercity: true, roof: true, bridge: Some(3),
                doors: [Door(stratum: Street, side: S, at: 6), Door(stratum: Street, side: W, at: 4),
                        Door(stratum: Skyways, side: N, at: 6)]),
            zones: ["public", "staff", "secure", "executive"],
            borders: [
                Border(zones: ("public", "staff"), lock: Card, always: true, one_way: true, ways: [Card, Net, Talk, Force]),
                Border(zones: ("staff", "secure"), lock: Card, always: true, ways: [Card, Net, Talk, Force]),
                Border(zones: ("staff", "executive"), lock: Card, always: true, ways: [Card, Net, Talk, Force]),
                Border(zones: ("secure", "executive"), lock: Keypad, always: true, ways: [Code, Keyjack, Net, Force]),
            ],
            levels: Levels(
                below: [
                    Level(name: "server basement", bands: [Band(zone: "staff", share: 55, rooms: ["plant room", "store"]),
                                                           Band(zone: "secure", share: 45, rooms: ["server room"])]),
                ],
                ground: Level(name: "lobby", pieces: ["gate line"], bands: [
                    Band(zone: "public", share: 55, rooms: ["reception"]),
                    Band(zone: "staff", share: 45, rooms: ["mail room"])]),
                middle: Some(Level(name: "open-plan floor", spine: Any, bands: [
                    Band(zone: "staff", share: 75, rooms: ["open plan"], fill: Some("meeting room")),
                    Band(zone: "secure", share: 25, rooms: ["records"])])),
                top: [Level(name: "executive floor", bands: [Band(zone: "staff", share: 35, rooms: ["outer office"]),
                                                            Band(zone: "executive", share: 65, rooms: ["executive office", "boardroom"])])],
            ),
            rooms: [
                Room(name: "reception", kind: Lobby, size: ((8, 6), (14, 10)), furniture: [Counter], stations: [Reception]),
                Room(name: "mail room", kind: Storage, size: ((4, 3), (6, 5)), furniture: [Shelf], stations: [Shelf]),
                Room(name: "open plan", kind: OpenPlan, size: ((10, 6), (20, 10)), furniture: [Desk, Desk, Desk, Desk], stations: [Desk, Desk]),
                Room(name: "meeting room", kind: Office, size: ((4, 4), (7, 5)), furniture: [Table]),
                Room(name: "records", kind: Storage, size: ((4, 3), (6, 5)), private: true, furniture: [Shelf]),
                Room(name: "plant room", kind: Plant, size: ((5, 4), (9, 6)), furniture: [Machine], stations: [Machine]),
                Room(name: "store", kind: Storage, size: ((3, 3), (5, 5)), furniture: [Shelf], stations: [Shelf]),
                Room(name: "server room", kind: Server, size: ((5, 4), (8, 6)), private: true, furniture: [Machine, Machine]),
                Room(name: "outer office", kind: Office, size: ((5, 4), (8, 6)), furniture: [Desk], stations: [Desk]),
                Room(name: "executive office", kind: Office, size: ((6, 5), (10, 7)), private: true, furniture: [Desk, Couch], stations: [Desk]),
                Room(name: "boardroom", kind: Office, size: ((6, 4), (10, 6)), furniture: [Table]),
            ],
            pieces: [Piece(name: "gate line", kind: GateLine)],
            links: [
                Link(name: "lifts", kind: Lift, zone: "staff", serves: Roles(["lobby", "open-plan floor", "executive floor"]),
                     cards: [("executive floor", "executive")]),
                Link(name: "goods lift", kind: Lift, zone: "staff", serves: Roles(["server basement", "lobby", "open-plan floor"])),
                Link(name: "stair", kind: Stair, zone: "staff", serves: All),
                Link(name: "fire stair", kind: Stair, zone: "staff", serves: All, alight: Ends),
                Link(name: "duct", kind: Crawl, zone: "staff", serves: All),
            ],
            crawls_in: [Crawl(stratum: Heights, zone: "staff")],
            objectives: [Objective(id: "server", name: "the server room", room: "server room", level: Some("server basement"))],
            security: [
                Security(size: Small, guards: [("public", 1), ("staff", 2), ("secure", 1)], cameras: (3, 5),
                         turrets: (0, 0), containers: (1, 2)),
                Security(size: Medium, guards: [("public", 1), ("staff", 2), ("secure", 2), ("executive", 1)],
                         cameras: (5, 9), turrets: (0, 1), turret_zones: ["secure"], containers: (2, 4)),
                Security(size: Large, guards: [("public", 2), ("staff", 3), ("secure", 3), ("executive", 2)],
                         cameras: (9, 15), turrets: (2, 4), turret_zones: ["secure", "executive"], containers: (3, 6)),
            ],
        ),
        Type(
            id: "metro",
            name: "metro station",
            builds: [],
            frame: Frame(kind: Depot, footprint: (32, 13), top: 0, undercity: true, roof: false,
                doors: [Door(stratum: Street, side: S, at: 8), Door(stratum: Street, side: S, at: 24),
                        Door(stratum: Street, side: N, at: 16), Door(stratum: Undercity, side: W, at: 6),
                        Door(stratum: Undercity, side: E, at: 6)]),
            zones: ["public", "paid", "staff", "secure"],
            borders: [
                Border(zones: ("public", "paid"), lock: Card, always: true, one_way: true, ways: [Card, Net, Talk, Force]),
                Border(zones: ("public", "staff"), lock: Card, always: true, ways: [Card, Net, Talk, Force]),
                Border(zones: ("paid", "staff"), lock: Card, always: true, ways: [Card, Net, Talk, Force]),
                Border(zones: ("staff", "secure"), lock: Keypad, always: true, ways: [Code, Keyjack, Net, Force]),
            ],
            levels: Levels(
                below: [
                    Level(name: "concourse", pieces: ["gate line"], bands: [
                        Band(zone: "public", share: 35, rooms: ["ticket hall"]),
                        Band(zone: "paid", share: 40, rooms: ["paid side"]),
                        Band(zone: "staff", share: 25, rooms: ["staff room", "cash room"])]),
                    Level(name: "platform", pieces: ["track"], bands: [
                        Band(zone: "staff", share: 20, rooms: ["equipment room"]),
                        Band(zone: "paid", share: 80, rooms: ["platform landing"])]),
                    Level(name: "platform", pieces: ["track"], bands: [
                        Band(zone: "staff", share: 20, rooms: ["equipment room"]),
                        Band(zone: "paid", share: 80, rooms: ["platform landing"])]),
                    Level(name: "service", bands: [
                        Band(zone: "staff", share: 60, rooms: ["workshop", "lockers"]),
                        Band(zone: "secure", share: 40, rooms: ["line control"])]),
                    Level(name: "drainage", bands: [
                        Band(zone: "staff", share: 70, rooms: ["sump"]),
                        Band(zone: "secure", share: 30, rooms: ["cable vault"])]),
                ],
                ground: Level(name: "hall", bands: [
                    Band(zone: "public", share: 80, rooms: ["station hall"]),
                    Band(zone: "staff", share: 20, rooms: ["staff room"])]),
            ),
            rooms: [
                Room(name: "station hall", kind: Hall, size: ((12, 8), (60, 24))),
                Room(name: "staff room", kind: BackRoom, size: ((4, 4), (8, 6)), private: true, furniture: [Table, Locker]),
                Room(name: "ticket hall", kind: Hall, size: ((12, 8), (40, 16)), furniture: [Vending, Counter], stations: [Reception]),
                Room(name: "paid side", kind: Hall, size: ((12, 8), (40, 16))),
                Room(name: "cash room", kind: Storage, size: ((3, 3), (5, 4)), private: true, furniture: [Locker]),
                Room(name: "equipment room", kind: Plant, size: ((4, 3), (8, 6)), furniture: [Machine], stations: [Machine]),
                Room(name: "platform landing", kind: Hall, size: ((10, 4), (40, 10))),
                Room(name: "workshop", kind: Storage, size: ((5, 4), (10, 6)), furniture: [Shelf, Machine], stations: [Machine]),
                Room(name: "lockers", kind: Lockers, size: ((4, 3), (6, 5)), furniture: [Locker, Bench]),
                Room(name: "line control", kind: Server, size: ((6, 5), (12, 8)), private: true, furniture: [Desk, Machine], stations: [Desk]),
                Room(name: "sump", kind: Plant, size: ((6, 4), (16, 8)), furniture: [Machine]),
                Room(name: "cable vault", kind: Server, size: ((4, 4), (8, 6)), private: true, furniture: [Machine]),
            ],
            pieces: [Piece(name: "gate line", kind: GateLine), Piece(name: "track", kind: Track)],
            links: [
                Link(name: "street stairs", kind: Stair, zone: "public", serves: Roles(["hall", "concourse"])),
                Link(name: "hall escalators", kind: Escalator, zone: "public", serves: Roles(["hall", "concourse"])),
                Link(name: "platform escalators", kind: Escalator, zone: "paid", serves: Roles(["concourse", "platform"])),
                Link(name: "platform lift", kind: Lift, zone: "paid", serves: Roles(["concourse", "platform"])),
                Link(name: "freight lift", kind: Lift, zone: "staff", serves: Roles(["hall", "concourse", "service"]),
                     cards: [("service", "staff")]),
                Link(name: "emergency stair", kind: Stair, zone: "staff", serves: Roles(["hall", "concourse", "platform", "service"]),
                     alight: Ends),
                Link(name: "ventilation shaft", kind: Crawl, zone: "staff", serves: Roles(["hall", "concourse", "platform", "service"])),
                Link(name: "old shaft", kind: Ladder, zone: "staff", serves: Roles(["service", "drainage"])),
            ],
            crawls_in: [Crawl(stratum: Undercity, zone: "staff")],
            objectives: [Objective(id: "core", name: "the Line Control core", room: "line control", level: Some("service"))],
            security: [
                Security(size: Small, guards: [("paid", 1), ("staff", 2), ("secure", 1)], cameras: (3, 5),
                         turrets: (0, 0), containers: (1, 2)),
                Security(size: Medium, guards: [("public", 1), ("paid", 2), ("staff", 2), ("secure", 2)],
                         cameras: (5, 9), turrets: (0, 1), turret_zones: ["secure"], containers: (2, 4)),
                Security(size: Large, guards: [("public", 2), ("paid", 3), ("staff", 3), ("secure", 3)],
                         cameras: (9, 15), turrets: (2, 4), turret_zones: ["secure"], containers: (3, 6)),
            ],
        ),
    ],
)
