// Story missions. A mission waits on one step at a time; when its trigger fires the
// step's effects run in order and the mission waits on the next. The last step closes
// the mission. Text slots: {role} the role's name, {role.title} its title,
// {role.place} where they work, {role.district} the district, {role.hours} the shift;
// {you} is the player's handle.
// `scenes` are scripted cinematics: a step's `Scene("id")` plays one, then its `next` if it
// names one, and the last one's end marks the step `Ended`, as a feed's does. A scene is a
// list of beats, in the look `Film` or `Bubbles`.
// Visitors (`pick: Visitor`) are never cast and take only {role} and {role.title}. Effects
// `Scene`, `Arrive` (a visitor or "you"), `Leave`, `Lights`; `At(HomeDoor)`: in or at your flat.
Story(
    cast: {
        "mezz": Role(
            name: "Mezz",
            title: "fixer",
            pick: NearestFixer,
            face: Some("hustler"),
        ),
        "marlo": Role(
            name: "Marlo",
            title: "cook",
            pick: Worker(professions: ["noodle_cook"], at: [], range: (30, 140)),
            face: None,
        ),
        "castellan": Role(
            name: "Castellan",
            title: "stranger",
            pick: Visitor,
            face: None,
            tint: Some((255, 200, 80)),
            look: Some("A tall man in a long coat, sitting like he owns the place."),
        ),
        "seren": Role(
            name: "Seren",
            title: "netrunner",
            pick: Visitor,
            face: None,
            tint: Some((255, 0, 200)),
            look: Some("Striking. A black netsuit, your rig's cable still at her neck."),
        ),
    },
    faces: {
        "hustler": Face(rows: [
            "................",
            ".....dddddd.....",
            "...dddddddddd...",
            "..dddddmmddddd..",
            "..ddmmmmmmmmdd..",
            "..dmllllllllmd..",
            "..mlbbllllbblm..",
            "..mlXXlllleelm..",
            "..mlXXllllllm...",
            "..mllllhhllllm..",
            "...mlllhllllm...",
            "...mllmmmmllm...",
            "....mllllllm....",
            ".....mmllmm.....",
            "....dmmmmmmd....",
            "..dddmmmmmmddd..",
            ".dddddddddddddd.",
            "dddddddddddddddd",
        ], eye: (255, 0, 200)),
        "silhouette": Face(rows: [
            "................",
            ".....dddddd.....",
            "....dmmmmmmd....",
            "...dmmmmmmmmd...",
            "...dmmmmmmmmd...",
            "...dmmmmmmmmd...",
            "...dmmmmmmmmd...",
            "...dmmmmmmmmd...",
            "....dmmmmmmd....",
            "....dmmmmmmd....",
            ".....dmmmmd.....",
            ".....dmmmmd.....",
            "......dmmd......",
            "....dddmmddd....",
            "..dddmmmmmmddd..",
            ".dmmmmmmmmmmmmd.",
            "dmmmmmmmmmmmmmmd",
            "dddddddddddddddd",
        ], eye: (255, 255, 255)),
    },
    missions: [
        Mission(id: "the_drop", title: "The drop", from: "mezz", steps: [
            Step(id: "welcome", when: NewGame, then: [
                Feed(from: "mezz", close: "take the package", text: [
                    "Ey, welcome to the block, choom. Word on the wire says you got what it takes. Preem. Let's find out.",
                    "Got a package needs walking across town. Nothing heavy, nothing hot. Goes to {marlo}, cooks noodles at {marlo.place} in {marlo.district}. Into his hands. Not the counter, not his cousin. Hands.",
                    "Do it clean, there's more where that came from. Don't open it. Don't get cute. Don't be late.",
                ]),
            ]),
            Step(id: "package", when: Ended("welcome"), then: [
                Give(item: "taped_package", count: 1),
                Dead(role: "marlo", look: "Face down on the pavement, apron still on. Not breathing."),
                Objective("Hand the package to {marlo} · {marlo.place} · {marlo.district}"),
            ]),
            Step(id: "body", when: Sees(role: "marlo", within: 6), then: [
                Log("`{marlo}` is dead"),
            ]),
            Step(id: "ring", when: After(minutes: 1), then: [
                Call(from: "mezz", lines: [
                    "Choom. Choom, you there? Whatever you're looking at, don't touch it.",
                    "{marlo} was meant to be breathing when you got there. Somebody got there first.",
                    "Badges are four minutes out, and they'll love you for this. Walk, don't run. Keep the package. Get home.",
                ]),
            ]),
            Step(id: "run", when: Ended("ring"), then: [
                Objective("Get home · keep the package"),
            ]),
            Step(id: "home", when: At(HomeDoor), then: [
                Log("`The drop` · home"),
            ]),
        ]),
        Mission(id: "house_call", title: "House call", from: "castellan", steps: [
            Step(id: "door", when: MissionDone(mission: "the_drop", minutes: 0), then: [
                Scene("house_call"),
            ]),
            Step(id: "rest", when: Ended("door"), then: [
                Objective("Sleep · {castellan} will be in touch"),
            ]),
            Step(id: "lay_low", when: After(minutes: 2), then: [
                Mail(from: "mezz", subject: "lay low", body: [
                    "You made it home. Good.",
                    "Keep the package somewhere they won't look, and don't open it.",
                    "Lay low. I'll call.",
                ]),
                Log("`House call` · `{castellan}` will be in touch"),
            ]),
            Step(id: "morning", when: After(minutes: 480), then: [
                Call(from: "castellan", lines: [
                    "Morning, {you}. Eight hours. That's all anyone gets from me.",
                    "There's a doctor who owes me. She'll put something in you worth having, on my tab.",
                    "Seren will send you the where. Don't keep her waiting.",
                ]),
            ]),
        ]),
    ],
    scenes: {
        // Seren's aside follows the film as its `next`, from the console too.
        "house_call": Scene(title: "House call", look: Film, next: Some("seren_aside"),
            pace: Pace(type: 45, walk: 0.3, hold: Some(2.5)), beats: [
            // The film sets its own stage, so it plays the same from the console:
            // you outside first, then the dark flat and who waits in it.
            Arrive(role: "you", at: HomeOutside),
            Lights(0.45),
            Arrive(role: "castellan", at: HomeFurniture(Couch)),
            Arrive(role: "seren", at: HomeRig),
            Stage("You key your code. The pad buzzes red."),
            Keypad(door: HomeDoor, code: Journal, result: Denied, keys: 0.22, hold: 0.8),
            Say(who: "you", text: "WTF…?"),
            Stage("The lock clicks from inside. The door slides open on a dark flat."),
            Door(at: HomeDoor, open: true),
            Wait(0.6),
            Say(who: "castellan", as: Some("A voice"), at: Some(HomeDoor), text: "Come in, {you}."),
            Stage("You step in."),
            Walk(who: "you", to: HomeInside(2)),
            Camera(HomeInside(2)),
            Stage("A man sits on your couch, waiting."),
            Say(who: "castellan", text: "Sit down. It's your couch, but sit anyway."),
            Say(who: "you", text: "Who the hell are you?"),
            Say(who: "castellan", text: "Everyone in this city has a file. Yours is three days old and empty."),
            Say(who: "castellan", text: "That makes you the most interesting person on this block."),
            Stage("From the bedroom, a woman, the rig's cable still at her neck."),
            Walk(who: "seren", to: Beside(You)),
            Say(who: "seren", text: "Your fixer's line leaks. I was on it the whole walk home. Sorry about the static."),
            Say(who: "you", text: "{mezz} set me up."),
            Say(who: "castellan", text: "{mezz} was told the job was clean, and believed it. That's why it worked."),
            Say(who: "you", text: "And {marlo}?"),
            Say(who: "castellan", hold: Some(4.0), text: "{marlo} sold names to the badges. Somebody was always going to put him on the pavement. I chose the night, and where you'd be standing."),
            Say(who: "castellan", text: "You walked. You kept your mouth shut. You came home. You didn't open it."),
            Say(who: "castellan", text: "Keep the package. There's a shard in it, a fixer's ledger. Old news, but its owner will pay to have it back."),
            Say(who: "seren", text: "Your deck's a toaster. I fixed what I could."),
            Say(who: "castellan", text: "Sleep. I'll be in touch."),
            Stage("He lets himself out."),
            Walk(who: "castellan", to: HomeOutside),
            Leave("castellan"),
            Door(at: HomeDoor, open: false),
        ]),
        "seren_aside": Scene(title: "House call", look: Bubbles,
            pace: Pace(type: 50, walk: 0.3, hold: Some(2.5)), beats: [
            Stage("Seren unplugs and makes for the door."),
            Walk(who: "seren", to: HomeInside(1)),
            Say(who: "seren", text: "Your lock's yours again. Same code."),
            Say(who: "seren", text: "{mezz} didn't sell you. Remember that when he calls."),
            Stage("She flicks your lights on on her way out."),
            Lights(1.0),
            Walk(who: "seren", to: HomeOutside),
            Leave("seren"),
        ]),
    },
)
