// Story missions. A mission waits on one step at a time; when its trigger fires the
// step's effects run in order and the mission waits on the next. The last step closes
// the mission. Text slots: {role} the role's name, {role.title} its title,
// {role.place} where they work, {role.district} the district, {role.hours} the shift;
// {you} is the player's handle.
// `scenes` are scripted cinematics: a step's `Scene("id")` plays one, then its `next` if it
// names one, and the last one's end marks the step `Ended`, as a feed's does. A scene is a
// list of beats, in the look `Film` or `Bubbles`.
// Visitors (`pick: Visitor`) are never cast and take only {role} and {role.title}. Effects
// `Scene`, `Arrive` (a visitor or "you"), `Leave`, `Lights`; `At(HomeDoor)`: in or at your flat.
// `news` items are put out by `News("id")`, one current at a time for `fresh` game minutes;
// their texts take slots, and the roles they name are roles the mission needs. `still` is
// 18 rows of 18 pixels, `0`-`6` the camera's greens dark to light, `r` the bracket's red.
// `Daze(seconds)` makes the screen swim.
// `pick: Nearest("ripperdoc")` casts the one of that profession nearest your home. A bare
// {role}, {role.title} or {role.spaced} (the name in spaced capitals) fills from the book
// when nobody plays the role; only the roles a mission acts on or places need a person.
// `Hold(role)` keeps someone at work against their hours; `Release(role)` lets them go
// once you are out of their building. `Unseal(item)` lets the pack open it. `Holo` says a
// line through your flat's set while you are in; `Note(at, text)` leaves one under a
// tile's Look. A mail's `code: Some(Clinic(role))` is learned as it lands and fills its
// {code}. The first read of a step's `Mail` marks the step `Ended`, as a feed's close does.
// `Tray` holds out the first set whose need holds: one piece to take, on `tab`'s tab in
// `from`'s chair. `Chromed(role)` fires once it is in and you are up.
// `At(By(role, within))`: beside the role's person, in sight. The mark `Chair(role)`:
// their chair.
// A need asks who you are: `Skill`, `Read(item)`, `Carries(item)`, `Unsealed(item)`,
// `Changed` / `Unchanged` (the jacket the camera saw), `Late(minute)`, `Not`, `All`. A
// `Say` with a `need` is said only when it holds. `when: Holds(need)` fires once the need
// holds, on any pass. `ObjectiveFit` sets the text of the first `Fit` whose need holds;
// the last one's need is `All([])`. `Told(item)`: someone said whose it is, so
// `Read(item)` holds.
// `readings` are what who you are finds in an item at the rig, at the bench or by its
// Look; the first whose need holds there is the one read. One with `tells: true` makes
// `Read(item)` hold once it shows: its card at the rig or the bench, the pack's card of
// the item for a Look.
Story(
    cast: {
        "mezz": Role(
            name: "Mezz",
            title: "fixer",
            pick: NearestFixer,
            face: Some("hustler"),
        ),
        "marlo": Role(
            name: "Marlo",
            title: "cook",
            pick: Worker(professions: ["noodle_cook"], at: [], range: (30, 140)),
            face: None,
        ),
        "castellan": Role(
            name: "Castellan",
            title: "stranger",
            pick: Visitor,
            face: None,
            tint: Some((255, 200, 80)),
            look: Some("A tall man in a long coat, sitting like he owns the place."),
        ),
        "seren": Role(
            name: "Seren",
            title: "netrunner",
            pick: Visitor,
            face: None,
            tint: Some((255, 0, 200)),
            look: Some("Striking. A black netsuit, your rig's cable still at her neck."),
        ),
        "odile": Role(name: "Odile Vance", title: "ripperdoc", pick: Nearest("ripperdoc"),
            face: None, tint: Some((160, 220, 255))),
        "coz": Role(name: "Coz", title: "fixer",
            pick: Worker(professions: ["fixer"], at: [], range: (40, 200)), face: None),
    },
    faces: {
        "hustler": Face(rows: [
            "................",
            ".....dddddd.....",
            "...dddddddddd...",
            "..dddddmmddddd..",
            "..ddmmmmmmmmdd..",
            "..dmllllllllmd..",
            "..mlbbllllbblm..",
            "..mlXXlllleelm..",
            "..mlXXllllllm...",
            "..mllllhhllllm..",
            "...mlllhllllm...",
            "...mllmmmmllm...",
            "....mllllllm....",
            ".....mmllmm.....",
            "....dmmmmmmd....",
            "..dddmmmmmmddd..",
            ".dddddddddddddd.",
            "dddddddddddddddd",
        ], eye: (255, 0, 200)),
        "silhouette": Face(rows: [
            "................",
            ".....dddddd.....",
            "....dmmmmmmd....",
            "...dmmmmmmmmd...",
            "...dmmmmmmmmd...",
            "...dmmmmmmmmd...",
            "...dmmmmmmmmd...",
            "...dmmmmmmmmd...",
            "....dmmmmmmd....",
            "....dmmmmmmd....",
            ".....dmmmmd.....",
            ".....dmmmmd.....",
            "......dmmd......",
            "....dddmmddd....",
            "..dddmmmmmmddd..",
            ".dmmmmmmmmmmmmd.",
            "dmmmmmmmmmmmmmmd",
            "dddddddddddddddd",
        ], eye: (255, 255, 255)),
    },
    missions: [
        Mission(id: "the_drop", title: "The drop", from: "mezz", steps: [
            Step(id: "welcome", when: NewGame, then: [
                Feed(from: "mezz", close: "take the package", text: [
                    "Ey, welcome to the block, choom. Word on the wire says you got what it takes. Preem. Let's find out.",
                    "Got a package needs walking across town. Nothing heavy, nothing hot. Goes to {marlo}, cooks noodles at {marlo.place} in {marlo.district}. Into his hands. Not the counter, not his cousin. Hands.",
                    "Do it clean, there's more where that came from. Don't open it. Don't get cute. Don't be late.",
                ]),
            ]),
            Step(id: "package", when: Ended("welcome"), then: [
                Give(item: "taped_package", count: 1),
                Dead(role: "marlo", look: "Face down on the pavement, apron still on. Not breathing."),
                Objective("Hand the package to {marlo} · {marlo.place} · {marlo.district}"),
            ]),
            Step(id: "body", when: Sees(role: "marlo", within: 6), then: [
                Log("`{marlo}` is dead"),
            ]),
            Step(id: "ring", when: After(minutes: 1), then: [
                Call(from: "mezz", lines: [
                    "Choom. Choom, you there? Whatever you're looking at, don't touch it.",
                    "{marlo} was meant to be breathing when you got there. Somebody got there first.",
                    "Badges are four minutes out, and they'll love you for this. Walk, don't run. Keep the package. Get home.",
                ]),
            ]),
            Step(id: "run", when: Ended("ring"), then: [
                Objective("Get home · keep the package"),
            ]),
            Step(id: "home", when: At(HomeDoor), then: [
                Log("`The drop` · home"),
            ]),
        ]),
        Mission(id: "house_call", title: "House call", from: "castellan", steps: [
            Step(id: "door", when: MissionDone(mission: "the_drop", minutes: 0), then: [
                Scene("house_call"),
            ]),
            Step(id: "rest", when: Ended("door"), then: [
                Objective("Sleep · {castellan} will be in touch"),
            ]),
            Step(id: "lay_low", when: After(minutes: 2), then: [
                Mail(from: "mezz", subject: "lay low", body: [
                    "You made it home. Good.",
                    "Keep the package somewhere they won't look, and don't open it.",
                    "Lay low. I'll call.",
                ]),
                Log("`House call` · `{castellan}` will be in touch"),
            ]),
            Step(id: "morning", when: After(minutes: 480), then: [
                Call(from: "castellan", lines: [
                    "Morning, {you}. Eight hours. That's all anyone gets from me.",
                    "There's a doctor who owes me. She'll put something in you worth having, on my tab.",
                    "Seren will send you the where. Don't keep her waiting.",
                ]),
            ]),
            Step(id: "up", when: Ended("morning"), then: [Log("`House call` · morning")]),
        ]),
        Mission(id: "morning_after", title: "The morning after", from: "castellan", steps: [
            Step(id: "wake", when: MissionDone(mission: "house_call", minutes: 0), then: [
                Scene("waking"),
            ]),
            Step(id: "news", when: Ended("wake"), then: [
                Daze(4.0),
                News("marlo"),
                Objective("Catch the news on the holo"),
            ]),
            Step(id: "saw", when: Ended("news"), then: [
                Mail(from: "mezz", subject: "the news", body: [
                    "Saw the news.",
                    "Don't go out looking like you.",
                ]),
                Objective("Read {mezz}'s mail · on your rig"),
            ]),
            // Seren breaks in once Mezz's mail is read.
            Step(id: "word", when: Ended("saw"), then: [
                Unseal("taped_package"),
                Holo(from: "seren", text: "Doctor's in by ten. Eat first."),
                Objective("Open the package · it's in your pack"),
            ]),
            Step(id: "open", when: Holds(Carries("ledger_shard")), then: [
                Log("`The morning after` · a ledger shard, in your pack"),
            ]),
        ]),
        Mission(id: "doctor", title: "Doctor's in by ten", from: "castellan", steps: [
            Step(id: "word", when: Holds(Unsealed("taped_package")), then: [
                Hold("odile"),
                Mail(from: "seren", subject: "ten", code: Some(Clinic("odile")), body: [
                    "Doctor's in by ten. Eat first.",
                    "Shutter's down till dark. Code's {code}. She knows you're coming.",
                    "The package is yours now. Open it.",
                    "— S",
                ]),
                Objective("See the doctor · {odile.place} · {odile.district} · by ten"),
            ]),
            Step(id: "in", when: At(By(role: "odile", within: 4)), then: [Scene("odile")]),
            Step(id: "tray", when: Ended("in"), then: [
                Tray(from: "odile", tab: "castellan", title: "her tray",
                    line: "One piece, on his tab. The rest go back in the drawer.", sets: [
                    TraySet(need: Skill("hacking"), items: ["neural_port", "target_lens", "subdermal_mesh"]),
                    TraySet(need: Skill("electronics"), items: ["grip_arm", "capacitor_ribs", "damper_cochlea"]),
                    TraySet(need: Skill("handguns"), items: ["target_lens", "adrenal_pump", "hardback_brace"]),
                    TraySet(need: Skill("blades"), items: ["piston_arm", "subdermal_mesh", "adrenal_pump"]),
                    TraySet(need: Skill("stealth"), items: ["nightglass_optics", "damper_cochlea", "smart_ink"]),
                    TraySet(need: Skill("streetwise"), items: ["secondhand_eyes", "bulldog_jaw", "filter_liver"]),
                    TraySet(need: Skill("medtech"), items: ["surgeon_arm", "filter_liver", "rebreather"]),
                    TraySet(need: Skill("athletics"), items: ["adrenal_pump", "hardback_brace", "subdermal_mesh"]),
                    TraySet(need: All([]), items: ["subdermal_mesh", "target_lens", "neural_port"]),
                ]),
                Objective("Sit in {odile}'s chair · your piece is on {castellan}'s tab"),
                // Her scene named the shard's owner to whoever hadn't read it.
                Told("ledger_shard"),
            ]),
            Step(id: "out", when: Chromed("odile"), then: [Scene("odile_out")]),
            Step(id: "free", when: Ended("out"), then: [
                Release("odile"),
                Log("`Doctor's in by ten` · on {castellan}'s tab"),
            ]),
        ]),
        // The hook, its own mission so a city with one fixer (Mezz) still plays the doctor.
        // It opens with the package; its last fit places the doctor, so a city without
        // one leaves it uncast.
        Mission(id: "ledger", title: "The ledger", from: "castellan", steps: [
            Step(id: "whose", when: Holds(Carries("ledger_shard")), then: [
                ObjectiveFit([
                    Fit(need: Skill("hacking"),
                        text: "Find out whose shard this is · read it at your rig"),
                    Fit(need: Skill("electronics"),
                        text: "Find out whose shard this is · open the casing at your bench"),
                    Fit(need: Skill("streetwise"),
                        text: "Find out whose shard this is · look it over in your pack"),
                    Fit(need: All([]),
                        text: "Find out whose shard this is · ask the doctor at {odile.place}"),
                ]),
            ]),
            Step(id: "know", when: Holds(Read("ledger_shard")), then: [
                Objective("Bring it to {coz} · {coz.place} · {coz.district}"),
            ]),
            Step(id: "sell", when: Talk("coz"), then: [
                Log("`{coz}` · \"The ledger? Not here. I'll find you.\""),
            ]),
        ]),
    ],
    scenes: {
        // Seren's aside follows the film as its `next`, from the console too.
        "house_call": Scene(title: "House call", look: Film, next: Some("seren_aside"),
            pace: Pace(type: 45, walk: 0.3, hold: Some(2.5)), beats: [
            // The film sets its own stage, so it plays the same from the console:
            // you outside first, then the dark flat and who waits in it.
            Arrive(role: "you", at: HomeOutside),
            Lights(0.45),
            Arrive(role: "castellan", at: HomeFurniture(Couch)),
            Arrive(role: "seren", at: HomeRig),
            Stage("You key your code. The pad buzzes red."),
            Keypad(door: HomeDoor, code: Journal, result: Denied, keys: 0.22, hold: 0.8),
            Say(who: "you", text: "WTF…?"),
            Stage("The lock clicks from inside. The door slides open on a dark flat."),
            Door(at: HomeDoor, open: true),
            Wait(0.6),
            Say(who: "castellan", as: Some("A voice"), at: Some(HomeDoor), text: "Come in, {you}."),
            Stage("You step in."),
            Walk(who: "you", to: HomeInside(2)),
            Camera(HomeInside(2)),
            Stage("A man sits on your couch, waiting."),
            Say(who: "castellan", text: "Sit down. It's your couch, but sit anyway."),
            Say(who: "you", text: "Who the hell are you?"),
            Say(who: "castellan", text: "Everyone in this city has a file. Yours is three days old and empty."),
            Say(who: "castellan", text: "That makes you the most interesting person on this block."),
            Stage("From the bedroom, a woman, the rig's cable still at her neck."),
            Walk(who: "seren", to: Beside(You)),
            Say(who: "seren", text: "Your fixer's line leaks. I was on it the whole walk home. Sorry about the static."),
            Say(who: "you", text: "{mezz} set me up."),
            Say(who: "castellan", text: "{mezz} was told the job was clean, and believed it. That's why it worked."),
            Say(who: "you", text: "And {marlo}?"),
            Say(who: "castellan", hold: Some(4.0), text: "{marlo} sold names to the badges. Somebody was always going to put him on the pavement. I chose the night, and where you'd be standing."),
            Say(who: "castellan", text: "You walked. You kept your mouth shut. You came home. You didn't open it."),
            Say(who: "castellan", text: "Keep the package. There's a shard in it, a fixer's ledger. Old news, but its owner will pay to have it back."),
            Say(who: "seren", text: "Your deck's a toaster. I fixed what I could."),
            Say(who: "castellan", text: "Sleep. I'll be in touch."),
            Stage("He lets himself out."),
            Walk(who: "castellan", to: HomeOutside),
            Leave("castellan"),
            Door(at: HomeDoor, open: false),
        ]),
        "seren_aside": Scene(title: "House call", look: Bubbles,
            pace: Pace(type: 50, walk: 0.3, hold: Some(2.5)), beats: [
            Stage("Seren unplugs and makes for the door."),
            Walk(who: "seren", to: HomeInside(1)),
            Say(who: "seren", text: "Your lock's yours again. Same code."),
            Say(who: "seren", text: "{mezz} didn't sell you. Remember that when he calls."),
            Stage("She flicks your lights on on her way out."),
            Lights(1.0),
            Walk(who: "seren", to: HomeOutside),
            Leave("seren"),
        ]),
        "waking": Scene(title: "The morning after", look: Bubbles,
            pace: Pace(type: 45, walk: 0.3, hold: Some(2.5)), beats: [
            Stage("Your head swims. Last night comes back in pieces: the red pad, the couch, her cable."),
            Wait(1.5),
            Say(who: "you", text: "…so that happened."),
        ]),
        "odile": Scene(title: "Doctor's in by ten", look: Bubbles,
            pace: Pace(type: 45, walk: 0.3, hold: Some(2.5)), beats: [
            Stage("One light on, over the chair."),
            Say(who: "odile", text: "He sends me strays."),
            Say(who: "odile", need: Some(Late(600)), text: "Ten, he said. He said you'd be late, too."),
            Say(who: "odile", need: Some(Changed), text: "New jacket. Good. The last one didn't think of that."),
            Say(who: "odile", need: Some(Unchanged), text: "Lose that jacket before you go. It's on every screen in {marlo.district}."),
            Say(who: "odile", need: Some(All([Not(Read("ledger_shard")), Carries("taped_package")])),
                text: "That tape's {coz}'s. You're walking a fixer's ledger round in daylight."),
            Say(who: "odile", need: Some(All([Not(Read("ledger_shard")), Carries("ledger_shard")])),
                text: "That shard's {coz}'s. You're walking a fixer's ledger round in daylight."),
            Say(who: "odile", need: Some(All([Not(Read("ledger_shard")),
                Not(Carries("taped_package")), Not(Carries("ledger_shard"))])),
                text: "He told me what you're carrying. Black tape, three turns? That's {coz}'s."),
            Say(who: "odile", text: "{castellan} pays for one piece. Pick."),
        ]),
        "odile_out": Scene(title: "Doctor's in by ten", look: Bubbles,
            pace: Pace(type: 45, walk: 0.3, hold: Some(2.5)), beats: [
            Say(who: "odile", text: "Three sat in that chair on his money before you."),
            Say(who: "odile", hold: Some(4.0), text: "Ask him where they are."),
            Note(at: Chair("odile"), text: "Three clinic tags hang off the lamp arm. The names are scratched off."),
        ]),
    },
    news: {
        "marlo": News(
            about: "marlo",
            headline: "Courier sought in {marlo.district}",
            report: [
                "A noodle cook was found dead late last night outside his stall at {marlo.place}. He was {marlo}, 41. Sources at the precinct say he was a paid informer.",
                "Officers want to speak to a courier a street camera caught leaving soon after, carrying a package. Anyone who knows them is asked to call it in.",
            ],
            reads: [
                "This is Newsline. A cook found dead outside his stall in {marlo.district}.",
                "Sources say {marlo} sold names to the precinct.",
                "Police want a word with a courier seen leaving with a package.",
                "Rain by noon. Lift nine is out again.",
            ],
            crawl: [
                "{marlo}, 41, named as police informer",
                "Courier sought in {marlo.district}",
                "Lift 9 out of service",
                "Rain by noon",
                "Arcology rents up 4%",
            ],
            overheard: [
                "That noodle cook in {marlo.district}. Informer, they're saying.",
                "Courier, they said. Jacket like that one.",
                "Whoever did the cook did the block a favour.",
                "Cameras saw a courier. Cameras see everybody.",
                "Sold names, my aunt says. Had it coming.",
            ],
            sought: "a courier",
            carrying: "a taped package",
            camera: "CAM 14",
            still: [
                "155555511111116661",
                "144444411011011211",
                "323232321111111211",
                "244444421101111211",
                "245555421111111211",
                "2222222211rr11rr11",
                "3333333322r3034r33",
                "333333332230004443",
                "300300332230066443",
                "300000332230304433",
                "331113332230303333",
                "2222222222r1113r32",
                "2222222222rr22rr22",
                "111111111311111111",
                "111111111311111111",
                "111111111111111111",
                "111111111311111111",
                "111111111311111111",
            ],
            close: "turn it off",
            fresh: 1440,
        ),
    },
    readings: {
        "ledger_shard": [
            Reading(at: Rig, need: Skill("hacking"), verb: "Read", head: "shard · read at the rig",
                close: "pull it", tells: true, rows: [
                Field("LEDGER", "214 entries · 2068–2071"),
                Field("owner", "`{coz}` · fixer"),
                Hot("ICE     open · cracked 02:13 last night"),
                Blank,
                Ledger(4, 214),
                Blank,
                Tag("too slow. —S"),
            ]),
            Reading(at: Bench, need: Skill("electronics"), verb: "Open the casing",
                head: "shard · casing open", close: "close the casing", tells: true, rows: [
                Art("┌─────────────────────┐   housing  matte, no maker"),
                Art("│ ░░░░░░░░░░░░░░░░░░░ │   data     locked · ICE 3"),
                Art("└┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┘   contacts gold, worn bright"),
                Art("  ╰── `{coz.spaced}` ──╯           mark     `{coz}` · burned in"),
                Blank,
                You("{coz}. Fixers sign their shards."),
            ]),
            Reading(at: Look, need: Skill("streetwise"), tells: true,
                text: "Black fixer's tape still round the casing, wound three times. {coz} wraps his like that."),
        ],
        "taped_package": [
            Reading(at: Look, need: All([Skill("streetwise"), Unsealed("taped_package")]),
                text: "Black fixer's tape, wound three times. {coz} wraps his like that."),
        ],
    },
)
