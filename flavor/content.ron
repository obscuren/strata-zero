// Starter kit: original names in the shared cyberpunk register.
// Every ItemKind and every Slot appears at least once. Ids are snake_case strings.
Content(
    items: [
        Item(id: "ratchet_smg", name: "Ratchet SMG", kind: Weapon, slot: Some(Primary), weight: 3.2, value: 900,
             desc: "Stamped-receiver machine pistol with a filed-down selector. Jams on cheap ammo, sings on the good stuff."),
        Item(id: "shiv_blade", name: "Monowire shiv", kind: Weapon, slot: Some(Secondary), weight: 0.4, value: 350, perks: [Stat(Reflex, 1)],
             desc: "A hand-wrapped grip around twenty centimetres of monofilament. Do not test the edge with a thumb."),
        Item(id: "hardhat", name: "Hardhat with visor", kind: Armor, slot: Some(Head), weight: 0.9, value: 60, perks: [HpMax(2)],
             desc: "Dock-issue hardhat. The visor still has the union sticker."),
        Item(id: "salvage_jacket", name: "Salvage jacket", kind: Armor, slot: Some(Torso), weight: 2.5, value: 420, perks: [HpMax(5)],
             desc: "Aramid panels sewn into a courier jacket. Stops a knife, argues with a pistol."),
        Item(id: "cargo_pants", name: "Cargo pants", kind: Armor, slot: Some(Legs), weight: 1.1, value: 90, perks: [Carry(4.0)],
             desc: "Eleven pockets. You have lost count of what is in them."),
        Item(id: "nightglass_optics", name: "Nightglass optics", kind: Cyberware, slot: Some(Eyes), weight: 0.2, value: 2200,
             perks: [Sight(4)], grants: ["lowlight"],
             desc: "Low-light lenses pulled from a security contractor's surplus. The left one still shows a corporate boot logo on cold start."),
        Item(id: "mirrorshades", name: "Mirrorshades", kind: Armor, slot: Some(Eyes), weight: 0.1, value: 150, perks: [Stat(Cool, 1)],
             desc: "Cheap chrome lenses. Nobody can tell where you are looking, including you."),
        Item(id: "neural_port", name: "Neural port", kind: Cyberware, slot: Some(Neural), weight: 0.1, value: 1500, grants: ["ping"],
             desc: "Standard jack behind the right ear. The seal itches when it rains."),
        Item(id: "grip_arm", name: "Grip arm", kind: Cyberware, slot: Some(Arms), weight: 4.0, value: 3100,
             perks: [Carry(12.0), Stat(Body, 1)],
             desc: "Hydraulic forearm with a clamp hand. Built for cargo, fine for doors."),
        Item(id: "pawnshop_deck", name: "Pawnshop deck", kind: Deck, slot: Some(Deck), weight: 1.8, value: 1200,
             perks: [Stat(Net, 1)], grants: ["netscan", "arc_trace"],
             desc: "Three previous owners, one of them dead. Boots in four seconds and runs hot."),
        Item(id: "soy_noodle_cup", name: "Soy-noodle cup", kind: Consumable, weight: 0.3, value: 8, use: Some(Heal(3)),
             desc: "Just add water. Water sold separately."),
        Item(id: "stim_patch", name: "Stim patch", kind: Consumable, weight: 0.05, value: 45, use: Some(Heal(15)),
             desc: "Twelve minutes of clarity, then the bill."),
        Item(id: "scrap_servo", name: "Scrap servo", kind: Component, weight: 0.6, value: 30,
             desc: "Pulled from a vending arm. Still answers to the right voltage."),
        Item(id: "copper_coil", name: "Copper coil", kind: Component, weight: 0.2, value: 12,
             desc: "A spool of salvaged wire. Every fix starts here."),
        Item(id: "burner_shard", name: "Burner shard", kind: Component, weight: 0.05, value: 25,
             desc: "A memory shard with one write cycle left."),
        Item(id: "bottle_caps", name: "Bottle caps", kind: Junk, weight: 0.1, value: 1,
             desc: "Someone in the Undercity collects these. You have not met them."),
        Item(id: "dead_phone", name: "Dead phone", kind: Junk, weight: 0.2, value: 5,
             desc: "Cracked screen, swollen battery, somebody's whole life inside."),
        Item(id: "ballistic_weave", name: "Ballistic weave", kind: Armor, slot: Some(Torso), weight: 3.0, value: 650, perks: [HpMax(8)],
             desc: "Layered weave that stops the first burst and remembers the second."),
        Item(id: "scrappers_roll", name: "Scrapper's roll", kind: Component, weight: 1.5, value: 140,
             desc: "Drivers, picks, a soldering iron that runs off a stolen cell."),
        Item(id: "burner_schematic", name: "Burner schematic", kind: Component, weight: 0.05, value: 90,
             desc: "One-shot plans etched on a shard that will not survive the read."),
    ],
    skills: [
        Skill(id: "blades", name: "Blades", stat: Reflex, desc: "Knives, shivs and anything with an edge."),
        Skill(id: "handguns", name: "Handguns", stat: Reflex, desc: "Pistols and machine pistols at street range."),
        Skill(id: "stealth", name: "Stealth", stat: Cool, desc: "Not being where the cameras are looking."),
        Skill(id: "hacking", name: "Hacking", stat: Net, desc: "Getting into systems from the inside of the Net."),
        Skill(id: "electronics", name: "Electronics", stat: Tech, desc: "Building and fixing hardware at the bench."),
        Skill(id: "streetwise", name: "Streetwise", stat: Cool, desc: "Who sells what, who owes whom, which alley to skip."),
        Skill(id: "athletics", name: "Athletics", stat: Body, desc: "Running, climbing and taking a fall."),
        Skill(id: "medtech", name: "Medtech", stat: Tech, desc: "Patches, stims and keeping blood inside people."),
        Skill(id: "ice_breaker", name: "ICE breaker", stat: Net, desc: "You find the seam in the ICE before it finds you."),
        Skill(id: "vault_run", name: "Vault run", stat: Net, desc: "You go past the vault door and come back with the vault."),
        Skill(id: "scrapcraft", name: "Scrapcraft", stat: Tech, desc: "Two broken things make one that works, mostly."),
        Skill(id: "overclock", name: "Overclock", stat: Tech, desc: "Everything you touch runs hot and fast and short."),
        Skill(id: "longarm", name: "Longarm", stat: Reflex, desc: "Rifles and the patience to use them."),
        Skill(id: "snapshot", name: "Snapshot", stat: Reflex, desc: "The first round leaves before the thought does."),
        Skill(id: "close_work", name: "Close work", stat: Reflex, desc: "Inside the swing, under the guard, done."),
        Skill(id: "riposte", name: "Riposte", stat: Reflex, desc: "They cut, you cut back, they stop."),
        Skill(id: "lockpick", name: "Lockpick", stat: Cool, desc: "Doors are a suggestion."),
        Skill(id: "vanish", name: "Vanish", stat: Cool, desc: "You were never here, and the footage agrees."),
        Skill(id: "haggle", name: "Haggle", stat: Cool, desc: "Every price has a second price."),
        Skill(id: "fixers_ear", name: "Fixer's ear", stat: Cool, desc: "You hear the job before it is posted."),
        Skill(id: "field_patch", name: "Field patch", stat: Tech, desc: "Tape, gel and a steady hand, on the run."),
        Skill(id: "stim_cocktail", name: "Stim cocktail", stat: Tech, desc: "Mix it right and the night lasts twice as long."),
        Skill(id: "freerun", name: "Freerun", stat: Body, desc: "Walls are a slower kind of floor."),
        Skill(id: "second_wind", name: "Second wind", stat: Body, desc: "The point where others stop is where you start."),
    ],
    talents: [
        Talent(id: "quick_draw", name: "Quick draw", skill: "handguns", desc: "First shot comes out before the argument ends."),
        Talent(id: "double_tap", name: "Double tap", skill: "handguns", desc: "Two rounds for the price of one trigger pull."),
        Talent(id: "backstab", name: "Backstab", skill: "blades", desc: "From behind, the first cut is the only cut."),
        Talent(id: "ghost", name: "Ghost", skill: "stealth", desc: "Cameras see a smear where you were."),
        Talent(id: "ice_pick", name: "Ice pick", skill: "hacking", desc: "Gates open a little faster for you."),
        Talent(id: "deep_dive", name: "Deep dive", skill: "hacking", desc: "Vaults give up their contents without the alarm."),
        Talent(id: "solder_hand", name: "Solder hand", skill: "electronics", desc: "Recipes need one fewer component."),
        Talent(id: "field_medic", name: "Field medic", skill: "medtech", desc: "Patches work on the move."),
    ],
    abilities: [
        Ability(id: "netscan", name: "Netscan", cooldown: 300, kind: Active(Scan(radius: 12)),
                fx: [Wave(colour: (0, 229, 255), ticks: 15)],
                desc: "The deck pulses the local grid and paints what it finds into your map."),
        Ability(id: "ping", name: "Ping", cooldown: 240, kind: Active(Ping(radius: 24)),
                fx: [Wave(colour: (255, 0, 200), ticks: 20), Glow(colour: (255, 0, 200), ticks: 180)],
                desc: "A handshake burst lights every terminal and stair in range."),
        Ability(id: "arc_trace", name: "Arc Trace", cooldown: 450, kind: Active(Trace(radius: 20)),
                fx: [Bolt(colour: (255, 240, 150), ticks: 36), Mark(colour: (255, 240, 150), ticks: 600)],
                desc: "The deck dumps a charge into the local grid. It arcs along whatever will carry it, lights every node it finds, and leaves them burning on your map for a while."),
        Ability(id: "lowlight", name: "Low-light", cooldown: 0, kind: Passive,
                desc: "The dark is just another colour."),
        Ability(id: "street_sense", name: "Street sense", cooldown: 0, kind: Passive,
                desc: "You know which alley to skip before you know why."),
        Ability(id: "signal_ghost", name: "Signal ghost", cooldown: 0, kind: Passive,
                desc: "You feel the Net's weather change before the ICE does."),
    ],
    quests: [
        Quest(id: "the_drop", title: "The drop", giver: "Mama Sol", location: "Night market",
              desc: "A package needs to cross three districts without being scanned. Mama Sol says it is noodles. It is not noodles.",
              objectives: ["Pick up the package at the noodle stall", "Cross the corp core without a scan", "Hand it to the docks fixer"]),
        Quest(id: "noodle_debt", title: "Noodle debt", giver: "Mama Sol", location: "Night market",
              desc: "You owe for three weeks of dinners. She will take credits, or a favour.",
              objectives: ["Pay 120 credits, or run the drop"]),
        Quest(id: "first_jack", title: "First jack", giver: "Yourself", location: "Anywhere with a terminal",
              desc: "Find a public terminal and jack in. Come back out.",
              objectives: ["Jack in at a street terminal", "Jack out again"]),
        Quest(id: "the_vault", title: "The vault", giver: "Unknown", location: "Corp core",
              desc: "A data vault in the core has a buyer. Nobody knows what is in it.",
              objectives: ["Locate the vault in the Net", "Get past the ICE", "Copy the vault"]),
    ],
    recipes: [
        Recipe(id: "wire_shiv", name: "Wire shiv", skill: "electronics",
               inputs: [("copper_coil", 1), ("scrap_servo", 1)], output: ("shiv_blade", 1),
               desc: "Wrap a servo housing around a coil and pull the wire taut."),
        Recipe(id: "hardhat_visor", name: "Hardhat visor", skill: "electronics",
               inputs: [("dead_phone", 1), ("copper_coil", 1)], output: ("hardhat", 1),
               desc: "A phone screen makes a serviceable visor once you have scraped the life off it."),
        Recipe(id: "caps_fence", name: "Fence caps", skill: "streetwise",
               inputs: [("bottle_caps", 10)], output: ("copper_coil", 1),
               desc: "The collector pays in wire."),
        Recipe(id: "stim_batch", name: "Stim batch", skill: "medtech",
               inputs: [("copper_coil", 1), ("soy_noodle_cup", 1)], output: ("stim_patch", 2),
               desc: "Boil, filter, pray."),
        Recipe(id: "optics_tune", name: "Optics tune", skill: "electronics",
               inputs: [("nightglass_optics", 1), ("copper_coil", 2)], output: ("nightglass_optics", 1),
               desc: "Re-seat the lenses and kill the boot logo."),
        Recipe(id: "servo_rebuild", name: "Servo rebuild", skill: "electronics",
               inputs: [("scrap_servo", 4), ("copper_coil", 2)], output: ("grip_arm", 1),
               desc: "Four servos and a lot of wire make an arm that mostly obeys."),
    ],
    creation: Creation(
        stat_base: 3, stat_cap: 8, stat_points: 20, point_cost: 2,
        sp: 6, name_max: 16, hp: 40, focus: 30,
        quests: [("the_drop", [true, false, false]), ("noodle_debt", [false]), ("first_jack", [true, true])],
    ),
    stat_blurbs: [
        (Body, "What the meat can take, and how much of it there is."),
        (Reflex, "The half second before the other guy moves."),
        (Tech, "Making chrome do what it was not sold to do."),
        (Cool, "The voice that does not shake when the gun comes out."),
        (Net, "How deep you can go and still come back."),
    ],
    origins: [
        Origin(id: "slab_rat", name: "SLAB RAT", line: "born between the slabs, knew the alleys before the alphabet",
               desc: "You learned the alleys before you learned to read. Nothing in the Slab surprises you, and you can run on nothing for days.",
               cheap: [Body, Cool], dear: [Tech, Net],
               emblem: ["░▒▓█▓▒░", "▒█ ◉ █▒", "░▒▓█▓▒░"]),
        Origin(id: "creche", name: "CRÈCHE", line: "raised in a tower nursery, badge revoked at sixteen",
               desc: "Filtered air, tutors on tap, a badge that opened every door until the day it did not. You still flinch at the smell of the street.",
               cheap: [Tech, Net], dear: [Body, Cool],
               emblem: ["┌─────┐", "│ ▣▣▣ │", "└─────┘"]),
        Origin(id: "stowaway", name: "STOWAWAY", line: "came down the gravity well in a freight can",
               desc: "Eleven days in a container with the lights off. You came out lean, quiet and sure that gravity is a privilege.",
               cheap: [Body, Reflex], dear: [Net, Tech],
               emblem: ["▁▂▃▅▃▂▁", "◢█▇▆▇█◣", "▔▔▔▔▔▔▔"]),
        Origin(id: "vat_grown", name: "VAT-GROWN", line: "decanted, not born; the lab lost the paperwork",
               desc: "Somebody designed you for a contract that fell through. The tank taught you patience and the Net taught you everything else.",
               cheap: [Net, Tech], dear: [Reflex, Cool],
               emblem: ["╭─────╮", "│ ◌ ◌ │", "╰─~~~─╯"]),
    ],
    professions: [
        Profession(id: "netrunner", name: "NETRUNNER", line: "you live behind the ICE",
                   desc: "The city is a rumour you check from the inside. Decks, jacks, the slow cold of a long run.",
                   cheap: [Net], dear: [Body], credits: 320,
                   kit: [("pawnshop_deck", 1), ("salvage_jacket", 1), ("dead_phone", 1), ("copper_coil", 3), ("burner_shard", 1)],
                   emblem: ["╔═╦═╦═╗", "║◆║◇║◆║", "╚═╩═╩═╝"]),
        Profession(id: "fixer", name: "FIXER", line: "you know who owes whom",
                   desc: "Every job in the Slab crosses a table you sit at. You carry a gun so you never have to use it.",
                   cheap: [Cool], dear: [Tech], credits: 600,
                   kit: [("ratchet_smg", 1), ("salvage_jacket", 1), ("mirrorshades", 1), ("bottle_caps", 20), ("soy_noodle_cup", 2)],
                   emblem: ["· ¤ ¤ ·", "¤ ◉ ◉ ¤", "· ¤ ¤ ·"]),
        Profession(id: "solo", name: "SOLO", line: "you get paid when it goes loud",
                   desc: "Doors, escorts, the part of the plan nobody wants to be in the room for. You are the room.",
                   cheap: [Body], dear: [Net], credits: 250,
                   kit: [("ratchet_smg", 1), ("ballistic_weave", 1), ("shiv_blade", 1), ("stim_patch", 2)],
                   emblem: ["▌▌▌▌▌▌▌", "▌◢██◣ ▌", "▌▌▌▌▌▌▌"]),
        Profession(id: "techie", name: "TECHIE", line: "you make broken things bite",
                   desc: "Dead chrome, dead drones, dead locks. Nothing stays dead on your bench for long.",
                   cheap: [Tech], dear: [Cool], credits: 300,
                   kit: [("salvage_jacket", 1), ("cargo_pants", 1), ("scrappers_roll", 1), ("scrap_servo", 3), ("copper_coil", 4), ("burner_schematic", 1)],
                   emblem: ["╔═╗ ╔═╗", "║◌╠═╣◌║", "╚═╝ ╚═╝"]),
    ],
    categories: [
        Category(id: "netrunner", name: "NETRUNNER", line: "the Net is a place and you live there", cost: 2,
                 skills: [CategorySkill(id: "hacking", cost: 0), CategorySkill(id: "ice_breaker", cost: 1), CategorySkill(id: "vault_run", cost: 2)],
                 grants: ["signal_ghost"]),
        Category(id: "wrench", name: "WRENCH", line: "nothing stays broken around you", cost: 2,
                 skills: [CategorySkill(id: "electronics", cost: 0), CategorySkill(id: "scrapcraft", cost: 1), CategorySkill(id: "overclock", cost: 2)],
                 unlocks: [Workbench]),
        Category(id: "iron", name: "IRON", line: "you are the one holding it", cost: 2,
                 skills: [CategorySkill(id: "handguns", cost: 0), CategorySkill(id: "longarm", cost: 1), CategorySkill(id: "snapshot", cost: 2)]),
        Category(id: "edge", name: "EDGE", line: "inside arm's reach is your reach", cost: 2,
                 skills: [CategorySkill(id: "blades", cost: 0), CategorySkill(id: "close_work", cost: 1), CategorySkill(id: "riposte", cost: 2)]),
        Category(id: "ghost", name: "GHOST", line: "the cameras remember a smear", cost: 2,
                 skills: [CategorySkill(id: "stealth", cost: 0), CategorySkill(id: "lockpick", cost: 1), CategorySkill(id: "vanish", cost: 2)]),
        Category(id: "street", name: "STREET", line: "everyone owes somebody", cost: 1,
                 skills: [CategorySkill(id: "streetwise", cost: 0), CategorySkill(id: "haggle", cost: 1), CategorySkill(id: "fixers_ear", cost: 2)],
                 grants: ["street_sense"]),
        Category(id: "ripper", name: "RIPPER", line: "blood goes back in", cost: 2,
                 skills: [CategorySkill(id: "medtech", cost: 0), CategorySkill(id: "field_patch", cost: 1), CategorySkill(id: "stim_cocktail", cost: 2)]),
        Category(id: "meat", name: "MEAT", line: "the body is the first machine", cost: 2,
                 skills: [CategorySkill(id: "athletics", cost: 0), CategorySkill(id: "freerun", cost: 1), CategorySkill(id: "second_wind", cost: 2)]),
    ],
    templates: [
        Template(id: "vex", handle: "VEX", line: "crèche kid behind the ICE",
                 origin: "creche", profession: "netrunner",
                 stats: Stats(body: 4, reflex: 6, tech: 5, cool: 5, net: 6),
                 categories: ["netrunner", "wrench", "street"], skills: ["hacking", "ice_breaker", "electronics", "streetwise"],
                 talents: ["ice_pick", "solder_hand"],
                 kit: [("ratchet_smg", 1), ("nightglass_optics", 1), ("scrap_servo", 2), ("soy_noodle_cup", 2), ("stim_patch", 1), ("bottle_caps", 12)]),
        Template(id: "kessler", handle: "KESSLER", line: "came down in a freight can, gets paid when it goes loud",
                 origin: "stowaway", profession: "solo",
                 stats: Stats(body: 8, reflex: 7, tech: 4, cool: 7, net: 3),
                 categories: ["iron", "edge", "meat"], skills: ["handguns", "blades", "athletics"],
                 talents: ["quick_draw", "backstab"], kit: [("cargo_pants", 1)]),
    ],
)
