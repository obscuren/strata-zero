// Starter kit: original names in the shared cyberpunk register.
// Every ItemKind and every Slot appears at least once. Ids are snake_case strings.
Content(
    items: [
        Item(id: "ratchet_smg", name: "Ratchet SMG", kind: Weapon, slot: Some(Primary), weight: 3.2, value: 900,
             desc: "Stamped-receiver machine pistol with a filed-down selector. Jams on cheap ammo, sings on the good stuff."),
        Item(id: "shiv_blade", name: "Monowire shiv", kind: Weapon, slot: Some(Secondary), weight: 0.4, value: 350, perks: [Stat(Reflex, 1)],
             desc: "A hand-wrapped grip around twenty centimetres of monofilament. Do not test the edge with a thumb."),
        Item(id: "hardhat", name: "Hardhat with visor", kind: Armor, slot: Some(Head), weight: 0.9, value: 60, perks: [HpMax(2)],
             desc: "Dock-issue hardhat. The visor still has the union sticker."),
        Item(id: "salvage_jacket", name: "Salvage jacket", kind: Armor, slot: Some(Torso), weight: 2.5, value: 420, perks: [HpMax(5)],
             desc: "Aramid panels sewn into a courier jacket. Stops a knife, argues with a pistol."),
        Item(id: "cargo_pants", name: "Cargo pants", kind: Armor, slot: Some(Legs), weight: 1.1, value: 90, perks: [Carry(4.0)],
             desc: "Eleven pockets. You have lost count of what is in them."),
        Item(id: "nightglass_optics", name: "Nightglass optics", kind: Cyberware, slot: Some(Eyes), weight: 0.2, value: 2200,
             perks: [Sight(4)], grants: ["lowlight"],
             desc: "Low-light lenses pulled from a security contractor's surplus. The left one still shows a corporate boot logo on cold start."),
        Item(id: "mirrorshades", name: "Mirrorshades", kind: Armor, slot: Some(Eyes), weight: 0.1, value: 150, perks: [Stat(Cool, 1)],
             desc: "Cheap chrome lenses. Nobody can tell where you are looking, including you."),
        Item(id: "neural_port", name: "Neural port", kind: Cyberware, slot: Some(Neural), weight: 0.1, value: 1500, grants: ["ping"],
             desc: "Standard jack behind the right ear. The seal itches when it rains."),
        Item(id: "grip_arm", name: "Grip arm", kind: Cyberware, slot: Some(Arms), weight: 4.0, value: 3100,
             perks: [Carry(12.0), Stat(Body, 1)],
             desc: "Hydraulic forearm with a clamp hand. Built for cargo, fine for doors."),
        Item(id: "pawnshop_deck", name: "Pawnshop deck", kind: Deck, slot: Some(Deck), weight: 1.8, value: 1200,
             perks: [Stat(Net, 1)], grants: ["netscan", "arc_trace"], deck: Some(DeckSpec(slots: 2, rating: 1)),
             desc: "Three previous owners, one of them dead. Boots in four seconds and runs hot."),
        Item(id: "soy_noodle_cup", name: "Soy-noodle cup", kind: Consumable, weight: 0.3, value: 8, use: Some(Heal(3)),
             desc: "Just add water. Water sold separately."),
        Item(id: "stim_patch", name: "Stim patch", kind: Consumable, weight: 0.05, value: 45, use: Some(Heal(15)),
             desc: "Twelve minutes of clarity, then the bill."),
        Item(id: "scrap_servo", name: "Scrap servo", kind: Component, weight: 0.6, value: 30,
             desc: "Pulled from a vending arm. Still answers to the right voltage."),
        Item(id: "copper_coil", name: "Copper coil", kind: Component, weight: 0.2, value: 12,
             desc: "A spool of salvaged wire. Every fix starts here."),
        Item(id: "burner_shard", name: "Burner shard", kind: Component, weight: 0.05, value: 25,
             desc: "A memory shard with one write cycle left."),
        Item(id: "bottle_caps", name: "Bottle caps", kind: Junk, weight: 0.1, value: 1,
             desc: "Someone in the Undercity collects these. You have not met them."),
        Item(id: "dead_phone", name: "Dead phone", kind: Junk, weight: 0.2, value: 5,
             desc: "Cracked screen, swollen battery, somebody's whole life inside."),
        Item(id: "ballistic_weave", name: "Ballistic weave", kind: Armor, slot: Some(Torso), weight: 3.0, value: 650, perks: [HpMax(8)],
             desc: "Layered weave that stops the first burst and remembers the second."),
        Item(id: "scrappers_roll", name: "Scrapper's roll", kind: Component, weight: 1.5, value: 140,
             desc: "Drivers, picks, a soldering iron that runs off a stolen cell."),
        Item(id: "burner_schematic", name: "Burner schematic", kind: Component, weight: 0.05, value: 90,
             desc: "One-shot plans etched on a shard that will not survive the read."),
        // Programs: loaded into a deck's slots, run against nodes in the Net.
        Item(id: "crack", name: "Crack", kind: Program, weight: 0.0, value: 150,
             program: Some(Program(op: Crack, rating: 1, size: 1, noise: 4, work: 3)),
             desc: "Brute force with manners. Opens anything that answers, loudly."),
        Item(id: "spoof", name: "Spoof", kind: Program, weight: 0.0, value: 200,
             program: Some(Program(op: Spoof, rating: 1, size: 1, noise: 2, work: 2)),
             desc: "Tells a lock or a lift it already let you through."),
        Item(id: "blind", name: "Blind", kind: Program, weight: 0.0, value: 120,
             program: Some(Program(op: Blind, rating: 1, size: 1, noise: 2, work: 2)),
             desc: "A camera keeps recording. Just not you."),
        Item(id: "copy", name: "Copy", kind: Program, weight: 0.0, value: 250,
             program: Some(Program(op: Copy, rating: 1, size: 1, noise: 3, work: 4)),
             desc: "Everything on the node, in the time it takes to notice."),
        Item(id: "backdoor", name: "Backdoor", kind: Program, weight: 0.0, value: 600,
             program: Some(Program(op: Backdoor, rating: 1, size: 2, noise: 2, work: 5)),
             desc: "A door only you know about, cut into the server's floor."),
        Item(id: "crack_2", name: "Crack II", kind: Program, weight: 0.0, value: 900,
             program: Some(Program(op: Crack, rating: 2, size: 2, noise: 3, work: 3)),
             desc: "The same hammer, swung by someone who has done this before."),
        Item(id: "copy_2", name: "Copy II", kind: Program, weight: 0.0, value: 1100,
             program: Some(Program(op: Copy, rating: 2, size: 2, noise: 2, work: 3)),
             desc: "Faster, quieter, and it leaves the checksums alone."),
        Item(id: "attack", name: "Attack", kind: Program, weight: 0.0, value: 400,
             program: Some(Program(op: Attack, rating: 1, size: 1, noise: 3, work: 1)),
             desc: "A spike of bad arithmetic aimed at whatever is looking at you."),
        Item(id: "shield", name: "Shield", kind: Program, weight: 0.0, value: 300,
             program: Some(Program(op: Shield, rating: 1, size: 1, noise: 1, work: 1)),
             desc: "Soaks the next hit. Then it is gone."),
        Item(id: "mask", name: "Mask", kind: Program, weight: 0.0, value: 350,
             program: Some(Program(op: Mask, rating: 1, size: 1, noise: 1, work: 1)),
             desc: "You are still there. You are just harder to see."),
        Item(id: "paydata", name: "Paydata shard", kind: Component, weight: 0.05, value: 300,
             desc: "Somebody's quarter, somebody's passwords, somebody's problem. A fixer will know whose."),
        Item(id: "vault_data", name: "Vault dump", kind: Component, weight: 0.05, value: 1500,
             desc: "A whole vault on one shard. Warm to the touch, which it should not be."),
    ],
    skills: [
        Skill(id: "blades", name: "Blades", stat: Reflex, desc: "Knives, shivs and anything with an edge."),
        Skill(id: "handguns", name: "Handguns", stat: Reflex, desc: "Pistols and machine pistols at street range."),
        Skill(id: "stealth", name: "Stealth", stat: Cool, desc: "Not being where the cameras are looking."),
        Skill(id: "hacking", name: "Hacking", stat: Net, desc: "Getting into systems from the inside of the Net."),
        Skill(id: "electronics", name: "Electronics", stat: Tech, desc: "Building and fixing hardware at the bench."),
        Skill(id: "streetwise", name: "Streetwise", stat: Cool, desc: "Who sells what, who owes whom, which alley to skip."),
        Skill(id: "athletics", name: "Athletics", stat: Body, desc: "Running, climbing and taking a fall."),
        Skill(id: "medtech", name: "Medtech", stat: Tech, desc: "Patches, stims and keeping blood inside people."),
        Skill(id: "ice_breaker", name: "ICE breaker", stat: Net, desc: "You find the seam in the ICE before it finds you."),
        Skill(id: "vault_run", name: "Vault run", stat: Net, desc: "You go past the vault door and come back with the vault."),
        Skill(id: "scrapcraft", name: "Scrapcraft", stat: Tech, desc: "Two broken things make one that works, mostly."),
        Skill(id: "overclock", name: "Overclock", stat: Tech, desc: "Everything you touch runs hot and fast and short."),
        Skill(id: "longarm", name: "Longarm", stat: Reflex, desc: "Rifles and the patience to use them."),
        Skill(id: "snapshot", name: "Snapshot", stat: Reflex, desc: "The first round leaves before the thought does."),
        Skill(id: "close_work", name: "Close work", stat: Reflex, desc: "Inside the swing, under the guard, done."),
        Skill(id: "riposte", name: "Riposte", stat: Reflex, desc: "They cut, you cut back, they stop."),
        Skill(id: "lockpick", name: "Lockpick", stat: Cool, desc: "Doors are a suggestion."),
        Skill(id: "vanish", name: "Vanish", stat: Cool, desc: "You were never here, and the footage agrees."),
        Skill(id: "haggle", name: "Haggle", stat: Cool, desc: "Every price has a second price."),
        Skill(id: "fixers_ear", name: "Fixer's ear", stat: Cool, desc: "You hear the job before it is posted."),
        Skill(id: "field_patch", name: "Field patch", stat: Tech, desc: "Tape, gel and a steady hand, on the run."),
        Skill(id: "stim_cocktail", name: "Stim cocktail", stat: Tech, desc: "Mix it right and the night lasts twice as long."),
        Skill(id: "freerun", name: "Freerun", stat: Body, desc: "Walls are a slower kind of floor."),
        Skill(id: "second_wind", name: "Second wind", stat: Body, desc: "The point where others stop is where you start."),
    ],
    // Five trees, one per stat: tiers from the bottom, two talents a tier, a capstone on
    // the fifth. A talent's prerequisite sits straight below it. Flags are promises the
    // combat and shop systems read later.
    trees: [
        Tree(stat: Body, name: "MEAT", line: "the body is the first machine",
             tiers: [["thick_skin", "long_haul"], ["second_lung", "iron_grip"], ["pain_editor", "wall_runner"],
                     ["juggernaut", "cat_fall"], ["meat_machine"]]),
        Tree(stat: Reflex, name: "EDGE", line: "the half second that decides it",
             tiers: [["quick_draw", "steady_hand"], ["double_tap", "backstab"], ["hair_trigger", "counter_cut"],
                     ["bullet_time", "razor_wire"], ["half_second"]]),
        Tree(stat: Tech, name: "WRENCH", line: "chrome does what you tell it",
             tiers: [["solder_hand", "field_medic"], ["overclocker", "stim_chemist"], ["scrap_eye", "trauma_kit"],
                     ["tinker", "chrome_whisperer"], ["machine_ghost"]]),
        Tree(stat: Cool, name: "STREET", line: "the city owes you",
             tiers: [["ghost", "silver_tongue"], ["shadow_step", "ear_to_the_ground"], ["skeleton_key", "cold_read"],
                     ["smoke", "ice_cold"], ["the_name"]]),
        Tree(stat: Net, name: "ICE", line: "the deep end of the grid",
             tiers: [["ice_pick", "wide_band"], ["deep_dive", "handshake"], ["arc_welder", "cold_boot"],
                     ["black_ice", "null_route"], ["deep_end"]]),
    ],
    talents: [
        // MEAT
        Talent(id: "thick_skin", name: "Thick skin", icon: '▲', ranks: 3, skill: Some("athletics"),
               effects: [[Perk(HpMax(3))], [Perk(HpMax(3))], [Perk(HpMax(4))]],
               desc: "Bruises are a kind of armour."),
        Talent(id: "long_haul", name: "Long haul", icon: '◆', ranks: 2, skill: Some("athletics"),
               effects: [[Perk(Carry(4.0))], [Perk(Carry(4.0))]],
               desc: "A strong back and no sense of when to put it down."),
        Talent(id: "second_lung", name: "Second lung", icon: '◉', ranks: 2, requires: Some("thick_skin"), skill: Some("second_wind"),
               effects: [[Perk(Focus(2))], [Perk(Focus(3))]],
               desc: "You keep going after the air runs out."),
        Talent(id: "iron_grip", name: "Iron grip", icon: '✚', ranks: 2, skill: Some("athletics"),
               effects: [[Perk(Stat(Body, 1))], [Flag("iron_grip")]],
               desc: "Whatever you hold stays held."),
        Talent(id: "pain_editor", name: "Pain editor", icon: '◈', ranks: 2, requires: Some("second_lung"), skill: Some("second_wind"),
               effects: [[Perk(HpMax(5))], [Flag("pain_editor")]],
               desc: "The signal still arrives. You just stop reading it."),
        Talent(id: "wall_runner", name: "Wall runner", icon: '⌁', ranks: 1, skill: Some("freerun"),
               effects: [[Flag("wall_runner")]],
               desc: "Walls are a slower kind of floor."),
        Talent(id: "juggernaut", name: "Juggernaut", icon: '☍', ranks: 2, requires: Some("pain_editor"),
               effects: [[Perk(Stat(Body, 1)), Perk(HpMax(4))], [Flag("juggernaut")]],
               desc: "You do not go around things any more."),
        Talent(id: "cat_fall", name: "Cat fall", icon: '✦', ranks: 1, requires: Some("wall_runner"), skill: Some("freerun"),
               effects: [[Flag("cat_fall")]],
               desc: "You land on your feet. Mostly."),
        Talent(id: "meat_machine", name: "Meat machine", icon: '⟡', ranks: 1, requires: Some("juggernaut"),
               effects: [[Perk(HpMax(10)), Perk(Stat(Body, 1)), Flag("meat_machine")]],
               desc: "The body is the first machine, and yours runs hot."),
        // EDGE
        Talent(id: "quick_draw", name: "Quick draw", icon: '⌖', ranks: 3, skill: Some("handguns"),
               effects: [[Flag("quick_draw")], [Perk(Stat(Reflex, 1))], [Perk(Sight(1))]],
               desc: "First shot comes out before the argument ends."),
        Talent(id: "steady_hand", name: "Steady hand", icon: '◉', ranks: 2, skill: Some("longarm"),
               effects: [[Perk(Sight(1))], [Flag("steady_hand")]],
               desc: "The barrel does not move until you do."),
        Talent(id: "double_tap", name: "Double tap", icon: '◆', ranks: 2, requires: Some("quick_draw"), skill: Some("handguns"),
               effects: [[Flag("double_tap")], [Perk(Stat(Reflex, 1))]],
               desc: "Two rounds for the price of one trigger pull."),
        Talent(id: "backstab", name: "Backstab", icon: '✚', ranks: 2, skill: Some("blades"),
               effects: [[Flag("backstab")], [Perk(Stat(Reflex, 1))]],
               desc: "From behind, the first cut is the only cut."),
        Talent(id: "hair_trigger", name: "Hair trigger", icon: '⌁', ranks: 2, requires: Some("double_tap"), skill: Some("snapshot"),
               effects: [[Flag("hair_trigger")], [Perk(Sight(1))]],
               desc: "The round leaves before the thought does."),
        Talent(id: "counter_cut", name: "Counter cut", icon: '☍', ranks: 2, requires: Some("backstab"), skill: Some("riposte"),
               effects: [[Flag("counter_cut")], [Perk(Stat(Reflex, 1))]],
               desc: "They cut, you cut back, they stop."),
        Talent(id: "bullet_time", name: "Bullet time", icon: '✦', ranks: 2, requires: Some("hair_trigger"),
               effects: [[Perk(Focus(3))], [Flag("bullet_time")]],
               desc: "Everything slows down except you."),
        Talent(id: "razor_wire", name: "Razor wire", icon: '◈', ranks: 1, requires: Some("counter_cut"), skill: Some("close_work"),
               effects: [[Flag("razor_wire")]],
               desc: "Inside the swing, under the guard, done."),
        Talent(id: "half_second", name: "The half second", icon: '⟡', ranks: 1, requires: Some("bullet_time"),
               effects: [[Perk(Stat(Reflex, 2)), Flag("half_second")]],
               desc: "The half second before the other guy moves is yours now."),
        // WRENCH
        Talent(id: "solder_hand", name: "Solder hand", icon: '⚙', ranks: 2, skill: Some("electronics"),
               effects: [[Flag("solder_hand")], [Perk(Stat(Tech, 1))]],
               desc: "Recipes need one fewer component."),
        Talent(id: "field_medic", name: "Field medic", icon: '✚', ranks: 2, skill: Some("medtech"),
               effects: [[Flag("field_medic")], [Perk(HpMax(3))]],
               desc: "Patches work on the move."),
        Talent(id: "overclocker", name: "Overclocker", icon: '⌁', ranks: 2, requires: Some("solder_hand"), skill: Some("overclock"),
               effects: [[Sharpen(ability: "netscan", radius: 3)], [Sharpen(ability: "netscan", cooldown: -60)]],
               desc: "Everything you touch runs hot and fast and short."),
        Talent(id: "stim_chemist", name: "Stim chemist", icon: '◉', ranks: 2, requires: Some("field_medic"), skill: Some("stim_cocktail"),
               effects: [[Perk(Focus(3))], [Flag("stim_chemist")]],
               desc: "Mix it right and the night lasts twice as long."),
        Talent(id: "scrap_eye", name: "Scrap eye", icon: '◆', ranks: 2, skill: Some("scrapcraft"),
               effects: [[Perk(Sight(1))], [Perk(Sight(1))]],
               desc: "You see parts where other people see trash."),
        Talent(id: "trauma_kit", name: "Trauma kit", icon: '◈', ranks: 1, requires: Some("stim_chemist"), skill: Some("field_patch"),
               effects: [[Perk(HpMax(3)), Flag("trauma_kit")]],
               desc: "Tape, gel and a steady hand, on the run."),
        Talent(id: "tinker", name: "Tinker", icon: '☍', ranks: 2, requires: Some("scrap_eye"),
               effects: [[Flag("tinker")], [Perk(Stat(Tech, 1))]],
               desc: "Two broken things make one that works, mostly."),
        Talent(id: "chrome_whisperer", name: "Chrome whisperer", icon: '✦', ranks: 2, requires: Some("trauma_kit"),
               effects: [[Perk(Carry(4.0))], [Perk(Stat(Tech, 1))]],
               desc: "Cyberware runs quieter when you are the one who fitted it."),
        Talent(id: "machine_ghost", name: "Machine ghost", icon: '⟡', ranks: 1, requires: Some("tinker"),
               effects: [[Perk(Stat(Tech, 2)), Flag("machine_ghost")]],
               desc: "Chrome does what you tell it. Then it does what you meant."),
        // STREET
        Talent(id: "ghost", name: "Ghost", icon: '✧', ranks: 2, skill: Some("stealth"),
               effects: [[Flag("ghost")], [Perk(Sight(1))]],
               desc: "Cameras see a smear where you were."),
        Talent(id: "silver_tongue", name: "Silver tongue", icon: '◉', ranks: 2, skill: Some("haggle"),
               effects: [[Flag("haggle")], [Perk(Stat(Cool, 1))]],
               desc: "Every price has a second price, and you know it."),
        Talent(id: "shadow_step", name: "Shadow step", icon: '⌁', ranks: 2, requires: Some("ghost"), skill: Some("vanish"),
               effects: [[Flag("shadow_step")], [Perk(Stat(Cool, 1))]],
               desc: "You were never here, and the footage agrees."),
        Talent(id: "ear_to_the_ground", name: "Ear to the ground", icon: '◆', ranks: 2, requires: Some("silver_tongue"), skill: Some("fixers_ear"),
               effects: [[Grant("street_sense"), Flag("fixer_jobs")], [Perk(Stat(Cool, 1))]],
               desc: "You hear the job before it is posted."),
        Talent(id: "skeleton_key", name: "Skeleton key", icon: '✚', ranks: 1, skill: Some("lockpick"),
               effects: [[Flag("skeleton_key")]],
               desc: "Doors are a suggestion."),
        Talent(id: "cold_read", name: "Cold read", icon: '◈', ranks: 2, skill: Some("streetwise"),
               effects: [[Perk(Focus(2))], [Perk(Focus(2))]],
               desc: "You hear the lie before they finish telling it."),
        Talent(id: "smoke", name: "Smoke", icon: '☍', ranks: 1, requires: Some("skeleton_key"),
               effects: [[Flag("smoke")]],
               desc: "Gone before the door finishes closing."),
        Talent(id: "ice_cold", name: "Ice cold", icon: '✦', ranks: 2, requires: Some("cold_read"),
               effects: [[Perk(Stat(Cool, 1))], [Flag("ice_cold")]],
               desc: "The voice does not shake when the gun comes out."),
        Talent(id: "the_name", name: "The name", icon: '⟡', ranks: 1, requires: Some("smoke"),
               effects: [[Perk(Stat(Cool, 2)), Flag("the_name")]],
               desc: "The city owes you. It knows your name, and it pays."),
        // ICE
        Talent(id: "ice_pick", name: "Ice pick", icon: '⌖', ranks: 2, skill: Some("hacking"),
               effects: [[Flag("ice_pick")], [Sharpen(ability: "netscan", cooldown: -60)]],
               desc: "Gates open a little faster for you."),
        Talent(id: "wide_band", name: "Wide band", icon: '◉', ranks: 2, skill: Some("hacking"),
               effects: [[Sharpen(ability: "netscan", radius: 3)], [Sharpen(ability: "netscan", radius: 3)]],
               desc: "The deck hears further than it was built to."),
        Talent(id: "deep_dive", name: "Deep dive", icon: '◆', ranks: 2, requires: Some("ice_pick"), skill: Some("vault_run"),
               effects: [[Flag("deep_dive")], [Perk(Stat(Net, 1))]],
               desc: "Vaults give up their contents without the alarm."),
        Talent(id: "handshake", name: "Handshake", icon: '✚', ranks: 2, requires: Some("wide_band"),
               effects: [[Grant("ping")], [Sharpen(ability: "ping", radius: 4, cooldown: -60)]],
               desc: "Every terminal in range answers when you knock."),
        Talent(id: "arc_welder", name: "Arc welder", icon: '⌁', ranks: 2, skill: Some("ice_breaker"),
               effects: [[Sharpen(ability: "arc_trace", radius: 4)], [Sharpen(ability: "arc_trace", cooldown: -90)]],
               desc: "The charge goes where you point it."),
        Talent(id: "cold_boot", name: "Cold boot", icon: '◈', ranks: 2,
               effects: [[Perk(Focus(3))], [Perk(Focus(3))]],
               desc: "Four seconds from dark to dangerous."),
        Talent(id: "black_ice", name: "Black ICE", icon: '☍', ranks: 2, requires: Some("arc_welder"),
               effects: [[Flag("black_ice")], [Perk(Stat(Net, 1))]],
               desc: "You find the seam in the ICE before it finds you."),
        Talent(id: "null_route", name: "Null route", icon: '✦', ranks: 1, requires: Some("cold_boot"),
               effects: [[Perk(Sight(1)), Flag("null_route")]],
               desc: "The trace goes somewhere. Not to you."),
        Talent(id: "deep_end", name: "The deep end", icon: '⟡', ranks: 1, requires: Some("black_ice"),
               effects: [[Perk(Stat(Net, 2)), Grant("arc_trace"), Flag("deep_end")]],
               desc: "How deep you can go and still come back: all the way."),
    ],
    abilities: [
        Ability(id: "netscan", name: "Netscan", cooldown: 300, kind: Active(Scan(radius: 12)),
                fx: [Wave(colour: (0, 229, 255), ticks: 15)],
                desc: "The deck pulses the local grid and paints what it finds into your map."),
        Ability(id: "ping", name: "Ping", cooldown: 240, kind: Active(Ping(radius: 24)),
                fx: [Wave(colour: (255, 0, 200), ticks: 20), Glow(colour: (255, 0, 200), ticks: 180)],
                desc: "A handshake burst lights every terminal and stair in range."),
        Ability(id: "arc_trace", name: "Arc Trace", cooldown: 450, kind: Active(Trace(radius: 20)),
                fx: [Bolt(colour: (255, 240, 150), ticks: 36), Mark(colour: (255, 240, 150), ticks: 600)],
                desc: "The deck dumps a charge into the local grid. It arcs along whatever will carry it, lights every node it finds, and leaves them burning on your map for a while."),
        Ability(id: "lowlight", name: "Low-light", cooldown: 0, kind: Passive,
                desc: "The dark is just another colour."),
        Ability(id: "street_sense", name: "Street sense", cooldown: 0, kind: Passive,
                desc: "You know which alley to skip before you know why."),
        Ability(id: "signal_ghost", name: "Signal ghost", cooldown: 0, kind: Passive,
                desc: "You feel the Net's weather change before the ICE does."),
    ],
    quests: [
        Quest(id: "the_drop", title: "The drop", giver: "Mama Sol", location: "Night market",
              desc: "A package needs to cross three districts without being scanned. Mama Sol says it is noodles. It is not noodles.",
              objectives: ["Pick up the package at the noodle stall", "Cross the corp core without a scan", "Hand it to the docks fixer"]),
        Quest(id: "noodle_debt", title: "Noodle debt", giver: "Mama Sol", location: "Night market",
              desc: "You owe for three weeks of dinners. She will take credits, or a favour.",
              objectives: ["Pay 120 credits, or run the drop"]),
        Quest(id: "first_jack", title: "First jack", giver: "Yourself", location: "Anywhere with a terminal",
              desc: "Find a public terminal and jack in. Come back out.",
              objectives: ["Jack in at a street terminal", "Jack out again"]),
        Quest(id: "the_vault", title: "The vault", giver: "Unknown", location: "Corp core",
              desc: "A data vault in the core has a buyer. Nobody knows what is in it.",
              objectives: ["Locate the vault in the Net", "Get past the ICE", "Copy the vault"]),
        Quest(id: "first_favour", title: "A favour", giver: "A fixer", location: "Your block",
              desc: "A mail on your rig: a neighbour owes the fixer, and there is a shard in the flat with the fixer's name on it. The door code came with the mail.",
              objectives: ["Read the mail on your rig", "Pick up the shard in the neighbour's flat"]),
    ],
    recipes: [
        Recipe(id: "wire_shiv", name: "Wire shiv", skill: "electronics",
               inputs: [("copper_coil", 1), ("scrap_servo", 1)], output: ("shiv_blade", 1),
               desc: "Wrap a servo housing around a coil and pull the wire taut."),
