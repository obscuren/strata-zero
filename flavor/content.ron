        Talent(id: "arc_welder", name: "Arc welder", icon: '⌁', ranks: 2, skill: Some("ice_breaker"),
               effects: [[Sharpen(ability: "arc_trace", radius: 4)], [Sharpen(ability: "arc_trace", cooldown: -90)]],
               desc: "The charge goes where you point it."),
        Talent(id: "cold_boot", name: "Cold boot", icon: '◈', ranks: 2,
               effects: [[Perk(Focus(3))], [Perk(Focus(3))]],
               desc: "Four seconds from dark to dangerous."),
        Talent(id: "black_ice", name: "Black ICE", icon: '☍', ranks: 2, requires: Some("arc_welder"),
               effects: [[Flag("black_ice")], [Perk(Attribute(Net, 1))]],
               desc: "You find the seam in the ICE before it finds you."),
        Talent(id: "null_route", name: "Null route", icon: '✦', ranks: 1, requires: Some("cold_boot"),
               effects: [[Perk(Sight(1)), Flag("null_route")]],
               desc: "The trace goes somewhere. Not to you."),
        Talent(id: "deep_end", name: "The deep end", icon: '⟡', ranks: 1, requires: Some("black_ice"),
               effects: [[Perk(Attribute(Net, 2)), Grant("arc_trace"), Flag("deep_end")]],
               desc: "How deep you can go and still come back: all the way."),
    ],
    abilities: [
        Ability(id: "netscan", name: "Netscan", cooldown: 300, kind: Active(Scan(radius: 12)),
                fx: [Wave(colour: (0, 229, 255), ticks: 15)],
                desc: "The deck pulses the local grid and paints what it finds into your map."),
        Ability(id: "ping", name: "Ping", cooldown: 240, kind: Active(Ping(radius: 24)),
                fx: [Wave(colour: (255, 0, 200), ticks: 20), Glow(colour: (255, 0, 200), ticks: 180)],
                desc: "A handshake burst lights every terminal and stair in range."),
        Ability(id: "arc_trace", name: "Arc Trace", cooldown: 450, kind: Active(Trace(radius: 20)),
                fx: [Bolt(colour: (255, 240, 150), ticks: 36), Mark(colour: (255, 240, 150), ticks: 600)],
                desc: "The deck dumps a charge into the local grid. It arcs along whatever will carry it, lights every node it finds, and leaves them burning on your map for a while."),
        Ability(id: "static", name: "Static", cooldown: 240,
                kind: Active(Strike(range: 8, damage: 6, stun: 1, skill: "hacking", ap: 2)),
                fx: [Flash(big: false), Streak(colour: (0, 229, 255)), Tear, Number(tag: true)],
                desc: "A burst of noise shoved down whatever is looking at you. Their chrome forgets what it was doing."),
        Ability(id: "jolt", name: "Jolt", cooldown: 180,
                kind: Active(Strike(range: 3, damage: 5, stun: 1, skill: "electronics", attribute: Tech, ap: 1, chain: 1)),
                fx: [Streak(colour: (0, 229, 255)), Tear, Spark, Number(tag: true)],
                desc: "An arc off the hand. It likes company: whoever stands next to them gets the rest."),
        Ability(id: "shove", name: "Shove", cooldown: 60,
                kind: Active(Strike(range: 1, damage: 3, stun: 0, skill: "athletics", attribute: Body, ap: 1, push: 2)),
                fx: [Chips, Trail, Number(tag: false)],
                desc: "Both hands, all of you. They end up somewhere else."),
        Ability(id: "redline", name: "Redline", cooldown: 900,
                kind: Active(Boost(once: true)),
                fx: [Kick(4), Pulse(colour: (0, 229, 255)), Number(tag: true)],
                desc: "The half second you did not have. Once; the body keeps the bill."),
        Ability(id: "bite", name: "Bite", cooldown: 60,
                kind: Active(Strike(range: 1, damage: 4, stun: 0, skill: "athletics", attribute: Body, ap: 1)),
                fx: [Chips, Number(tag: false)],
                desc: "Steel teeth on a hinge rated for car doors."),
        Ability(id: "spit", name: "Spit", cooldown: 300,
                kind: Active(Strike(range: 4, damage: 3, stun: 1, skill: "athletics", attribute: Reflex, ap: 1)),
                fx: [Streak(colour: (180, 255, 120)), Chips, Number(tag: false)],
                desc: "A dart off the tongue. They notice the sting before the dart."),
        Ability(id: "whip", name: "Whip", cooldown: 90,
                kind: Active(Strike(range: 2, damage: 6, stun: 0, skill: "blades", attribute: Reflex, ap: 1)),
                fx: [Streak(colour: (230, 240, 255)), Chips, Number(tag: false)],
                desc: "A wire too thin to see, on a spool in the wrist."),
        Ability(id: "scout", name: "Scout", cooldown: 600, kind: Active(Scan(radius: 18)),
                fx: [Wave(colour: (120, 255, 120), ticks: 20)],
                desc: "The drone goes up, the drone comes back, the floor is on your map."),
        Ability(id: "deadeye", name: "Deadeye", cooldown: 120,
                kind: Active(Mark(range: 12, bonus: 20, ap: 1)),
                fx: [Mark(colour: (255, 0, 200), ticks: 12)],
                desc: "You read them, and after that every round knows the way."),
        Ability(id: "lowlight", name: "Low-light", cooldown: 0, kind: Passive,
                desc: "The dark is just another colour."),
        Ability(id: "street_sense", name: "Street sense", cooldown: 0, kind: Passive,
                desc: "You know which alley to skip before you know why."),
        Ability(id: "signal_ghost", name: "Signal ghost", cooldown: 0, kind: Passive,
                desc: "You feel the Net's weather change before the ICE does."),
    ],
    quests: [],
    recipes: [
        Recipe(id: "wire_shiv", name: "Wire shiv", skill: "electronics",
               inputs: [("copper_coil", 1), ("scrap_servo", 1)], output: ("shiv_blade", 1),
               desc: "Wrap a servo housing around a coil and pull the wire taut.",
               steps: ["wrap the coil", "pull it taut"]),
        Recipe(id: "hardhat_visor", name: "Hardhat visor", skill: "electronics",
               inputs: [("dead_phone", 1), ("copper_coil", 1)], output: ("hardhat", 1),
               desc: "A phone screen makes a serviceable visor once you have scraped the life off it.",
               steps: ["scrape the glass", "wire it in"]),
        Recipe(id: "caps_fence", name: "Fence caps", skill: "streetwise",
               inputs: [("bottle_caps", 10)], output: ("copper_coil", 1),
               desc: "The collector pays in wire.",
               steps: ["count the caps", "haggle", "take the wire"]),
        Recipe(id: "stim_batch", name: "Stim batch", skill: "medtech",
               inputs: [("copper_coil", 1), ("soy_noodle_cup", 1)], output: ("stim_patch", 2),
               desc: "Boil, filter, pray.",
               steps: ["boil", "filter", "pray"]),
        Recipe(id: "optics_tune", name: "Optics tune", skill: "electronics",
               inputs: [("nightglass_optics", 1), ("copper_coil", 2)], output: ("nightglass_optics", 1),
               desc: "Re-seat the lenses and kill the boot logo.",
               steps: ["re-seat lenses", "kill boot logo"]),
        Recipe(id: "servo_rebuild", name: "Servo rebuild", skill: "electronics",
               inputs: [("scrap_servo", 4), ("copper_coil", 2)], output: ("grip_arm", 1),
               desc: "Four servos and a lot of wire make an arm that mostly obeys.",
               steps: ["strip", "rewind", "seat"]),
        Recipe(id: "ratchet_build", name: "Ratchet SMG", skill: "scrapcraft",
               inputs: [("ratchet_receiver", 1), ("ratchet_stock", 1), ("ratchet_barrel", 1), ("ratchet_mag", 1), ("ratchet_trigger", 1)],
               output: ("ratchet_smg", 1),
               desc: "Five parts and a pin punch. It only goes together one way."),
    ],
    creation: Creation(
        attribute_base: 3, attribute_cap: 8, attribute_points: 20, point_cost: 2,
        sp: 600, name_max: 16, hp: 40, focus: 30, talent_points: 1, tier_gate: 3,
    ),
    attribute_blurbs: [
        (Body, "What the meat can take, and how much of it there is."),
        (Reflex, "The half second before the other guy moves."),
        (Tech, "Making chrome do what it was not sold to do."),
        (Cool, "The voice that does not shake when the gun comes out."),
        (Net, "How deep you can go and still come back."),
    ],
    number_blurbs: [
        ("HP", "How much you can bleed before you go down. Stims put it back."),
        ("FOC", "How long your head holds in the Net. Grey ICE drains it, and at zero the deck dumps you back in the meat."),
        ("ARM", "Each point turns a tenth of the rounds that hit you: they spark off and do nothing. Six points is as good as it gets."),
        ("SGT", "How many tiles you see from where you stand. Daylight stretches it under open sky; the undercity stays dark."),
        ("CAR", "Kilograms you can haul, what you wear counted, before you are overburdened. Chrome in you weighs nothing; LOAD is what it costs."),
        ("MOV", "Tiles you cover in a turn of a fight on foot. In a construct your avatar walks at its own pace."),
        ("KIN", "Bullets and shrapnel. The share of every round and frag blast that never gets through."),
        ("THM", "Fire and heat. The share of a satchel charge you walk away from."),
        ("SHK", "Flash and current. The share of a flashbang's stun you shake off."),
        ("EMP", "Electromagnetic pulse. Meat shrugs it off; chrome does not. Every piece in you takes 2 off, and below zero a puck hits harder."),
        ("TOX", "Gas and poison. The share of a choke can's cloud your lungs refuse."),
        ("FBK", "What the Net pushes back down the wire. The share of black ICE's burn and grey ICE's drain that never reaches you."),
    ],
    origins: [
        Origin(id: "slab_rat", name: "SLAB RAT", line: "born between the slabs, knew the alleys before the alphabet",
               desc: "You learned the alleys before you learned to read. Nothing in the Slab surprises you, and you can run on nothing for days.",
               cheap: [Body, Cool], dear: [Tech, Net],
               emblem: ["░▒▓█▓▒░", "▒█ ◉ █▒", "░▒▓█▓▒░"]),
        Origin(id: "creche", name: "CRÈCHE", line: "raised in a tower nursery, badge revoked at sixteen",
               desc: "Filtered air, tutors on tap, a badge that opened every door until the day it did not. You still flinch at the smell of the street.",
               cheap: [Tech, Net], dear: [Body, Cool],
               emblem: ["┌─────┐", "│ ▣▣▣ │", "└─────┘"]),
        Origin(id: "stowaway", name: "STOWAWAY", line: "came down the gravity well in a freight can",
               desc: "Eleven days in a container with the lights off. You came out lean, quiet and sure that gravity is a privilege.",
               cheap: [Body, Reflex], dear: [Net, Tech],
               emblem: ["▁▂▃▅▃▂▁", "◢█▇▆▇█◣", "▔▔▔▔▔▔▔"]),
        Origin(id: "vat_grown", name: "VAT-GROWN", line: "decanted, not born; the lab lost the paperwork",
               desc: "Somebody designed you for a contract that fell through. The tank taught you patience and the Net taught you everything else.",
               cheap: [Net, Tech], dear: [Reflex, Cool],
               emblem: ["╭─────╮", "│ ◌ ◌ │", "╰─~~~─╯"]),
    ],
    professions: [
        Profession(id: "netrunner", name: "NETRUNNER", line: "you live behind the ICE",
                   desc: "The city is a rumour you check from the inside. Decks, jacks, the slow cold of a long run.",
                   cheap: [Net], dear: [Body], credits: 320,
                   kit: [("pawnshop_deck", 1), ("crack", 1), ("copy", 1), ("attack", 1), ("salvage_jacket", 1), ("dead_phone", 1), ("copper_coil", 3), ("burner_shard", 1)],
                   emblem: ["╔═╦═╦═╗", "║◆║◇║◆║", "╚═╩═╩═╝"]),
        Profession(id: "fixer", name: "FIXER", line: "you know who owes whom",
                   desc: "Every job in the Slab crosses a table you sit at. You carry a gun so you never have to use it.",
                   cheap: [Cool], dear: [Tech], credits: 600,
                   kit: [("ratchet_smg", 1), ("salvage_jacket", 1), ("mirrorshades", 1), ("spoof", 1), ("bottle_caps", 20), ("soy_noodle_cup", 2)],
                   emblem: ["· ¤ ¤ ·", "¤ ◉ ◉ ¤", "· ¤ ¤ ·"]),
        Profession(id: "solo", name: "SOLO", line: "you get paid when it goes loud",
                   desc: "Doors, escorts, the part of the plan nobody wants to be in the room for. You are the room.",
                   cheap: [Body], dear: [Net], credits: 250,
                   kit: [("ratchet_smg", 1), ("ballistic_weave", 1), ("shiv_blade", 1), ("stim_patch", 2)],
                   emblem: ["▌▌▌▌▌▌▌", "▌◢██◣ ▌", "▌▌▌▌▌▌▌"]),
        Profession(id: "techie", name: "TECHIE", line: "you make broken things bite",
                   desc: "Dead chrome, dead drones, dead locks. Nothing stays dead on your bench for long.",
                   cheap: [Tech], dear: [Cool], credits: 300,
                   kit: [("salvage_jacket", 1), ("cargo_pants", 1), ("scrappers_roll", 1), ("scrap_servo", 3), ("copper_coil", 4), ("burner_schematic", 1)],
                   emblem: ["╔═╗ ╔═╗", "║◌╠═╣◌║", "╚═╝ ╚═╝"]),
    ],
    categories: [
        Category(id: "netrunner", name: "NETRUNNER", line: "the Net is a place and you live there", cost: 200,
