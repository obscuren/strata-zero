// Starter kit: original names in the shared cyberpunk register.
// Every ItemKind and every Slot appears at least once. Ids are snake_case strings.
Content(
    items: [
        Item(id: "ratchet_smg", name: "Ratchet SMG", kind: Weapon, slot: Some(Primary), weight: 3.2, value: 900,
             look: Some(Ratchet), sockets: [Muzzle, Rail],
             weapon: Some(Weapon(skill: "handguns", damage: 4, rounds: 3, range: 12,
                                 fx: [Flash(big: true), Tracer(colour: (255, 170, 40), speed: 3), Casing, Chips, Spark, Number(tag: false)])),
             desc: "Stamped-receiver machine pistol with a filed-down selector. Jams on cheap ammo, sings on the good stuff."),
        Item(id: "whisper_smg", name: "Whisper SMG", kind: Weapon, slot: Some(Primary), weight: 2.8, value: 1400,
             look: Some(Ratchet),
             weapon: Some(Weapon(skill: "handguns", damage: 4, rounds: 3, range: 12,
                                 fx: [Flash(big: true), Streak(colour: (240, 240, 240)), Casing, Chips, Spark, Number(tag: false)])),
             desc: "Integrally suppressed, polymer everything. The rounds are gone before the sound is."),
        Item(id: "scrap_nine", name: "Scrap nine", kind: Weapon, slot: Some(Primary), weight: 0.9, value: 320,
             weapon: Some(Weapon(skill: "handguns", damage: 5, rounds: 1, range: 8,
                                 fx: [Flash(big: false), Tracer(colour: (255, 170, 40), speed: 3), Casing, Chips, Spark, Number(tag: false)])),
             desc: "Nine millimetres of somebody else's problem. The serial was never there."),
        Item(id: "shiv_blade", name: "Monowire shiv", kind: Weapon, slot: Some(Secondary), weight: 0.4, value: 350, perks: [Attribute(Reflex, 1)],
             desc: "A hand-wrapped grip around twenty centimetres of monofilament. Do not test the edge with a thumb."),
        Item(id: "hardhat", name: "Hardhat with visor", kind: Armor, slot: Some(Head), weight: 0.9, value: 60, perks: [HpMax(2)],
             desc: "Dock-issue hardhat. The visor still has the union sticker."),
        Item(id: "salvage_jacket", name: "Salvage jacket", kind: Armor, slot: Some(Torso), weight: 2.5, value: 420, perks: [HpMax(5)],
             desc: "Aramid panels sewn into a courier jacket. Stops a knife, argues with a pistol."),
        Item(id: "cargo_pants", name: "Cargo pants", kind: Armor, slot: Some(Legs), weight: 1.1, value: 90, perks: [Carry(4.0)],
             desc: "Eleven pockets. You have lost count of what is in them."),
        Item(id: "nightglass_optics", name: "Nightglass optics", kind: Cyberware, weight: 0.2, value: 2200,
             implant: Some(Implant(fits: Eyes, load: 2)), perks: [Sight(4)], grants: ["lowlight"],
             desc: "Low-light lenses pulled from a security contractor's surplus. The left one still shows a corporate boot logo on cold start."),
        Item(id: "mirrorshades", name: "Mirrorshades", kind: Armor, slot: Some(Eyes), weight: 0.1, value: 150, perks: [Attribute(Cool, 1)],
             desc: "Cheap chrome lenses. Nobody can tell where you are looking, including you."),
        Item(id: "neural_port", name: "Neural port", kind: Cyberware, weight: 0.1, value: 1500,
             implant: Some(Implant(fits: Neural, load: 1)), grants: ["ping", "static"],
             desc: "Standard jack behind the right ear. The seal itches when it rains."),
        Item(id: "grip_arm", name: "Grip arm", kind: Cyberware, weight: 4.0, value: 3100,
             implant: Some(Implant(fits: Arm, load: 3)), sockets: [Hand, Forearm],
             perks: [Carry(12.0), Attribute(Body, 1)],
             desc: "Hydraulic forearm with a clamp hand. Built for cargo, fine for doors."),
        Item(id: "piston_arm", name: "Piston arm", kind: Cyberware, weight: 5.0, value: 2800,
             implant: Some(Implant(fits: Arm, load: 3)), sockets: [Hand, Forearm],
             perks: [Attribute(Body, 1)], grants: ["shove"],
             desc: "A piston in a sleeve, bolted on at the elbow. Good for arguments that have gone physical."),
        Item(id: "adrenal_pump", name: "Adrenal pump", kind: Cyberware, weight: 0.6, value: 3400,
             implant: Some(Implant(fits: Organs, load: 2)), grants: ["redline"],
             desc: "A pump under the ribs that sells you the half second and bills the body later."),
        Item(id: "arc_hand", name: "Arc hand", kind: Cyberware, weight: 2.5, value: 2600,
             implant: Some(Implant(fits: Socket(Hand), load: 1)), perks: [Resist(Shock, 10)], grants: ["jolt"],
             desc: "A hand that spits charge at whatever it touches. Keep it dry."),
        Item(id: "target_lens", name: "Target lens", kind: Cyberware, weight: 0.2, value: 2200,
             implant: Some(Implant(fits: Eyes, load: 2)), perks: [Sight(1)], grants: ["deadeye"],
             desc: "A lens with a box that follows whoever you are thinking about shooting."),
        Item(id: "limbic_damper", name: "Limbic damper", kind: Cyberware, weight: 0.1, value: 1800,
             implant: Some(Implant(fits: Neural, load: 2)),
             perks: [Attribute(Cool, 1)],
             desc: "Files the edges off fear. Also off joy, but who's counting."),
        Item(id: "feedback_fuse", name: "Feedback fuse", kind: Cyberware, weight: 0.1, value: 1200,
             implant: Some(Implant(fits: Neural, load: 1)),
             perks: [Resist(Feedback, 25)],
             desc: "A cheap breaker between you and the Net. Pops once, smells of hair."),
        Item(id: "secondhand_eyes", name: "Secondhand eyes", kind: Cyberware, weight: 0.2, value: 600,
             implant: Some(Implant(fits: Eyes, load: 1)),
             perks: [Sight(1)],
             desc: "Someone else's eyes. Their last view is still burned into the corner."),
        Item(id: "damper_cochlea", name: "Damper cochlea", kind: Cyberware, weight: 0.1, value: 900,
             implant: Some(Implant(fits: Ears, load: 1)),
             perks: [Resist(Shock, 25)],
             desc: "Clamps down on anything loud. Conversations included."),
        Item(id: "bulldog_jaw", name: "Bulldog jaw", kind: Cyberware, weight: 0.8, value: 1900,
             implant: Some(Implant(fits: Jaw, load: 2)), grants: ["bite"],
             desc: "A steel jaw on a hinge rated for car doors. Smile carefully."),
        Item(id: "rebreather", name: "Rebreather", kind: Cyberware, weight: 0.3, value: 1100,
             implant: Some(Implant(fits: Jaw, load: 1)),
             perks: [Resist(Toxin, 40)],
             desc: "A filter where your back teeth were. Gas clouds become a suggestion."),
        Item(id: "spit_dart", name: "Spit dart", kind: Cyberware, weight: 0.2, value: 1600,
             implant: Some(Implant(fits: Jaw, load: 2)), grants: ["spit"],
             desc: "A dart under the tongue. Kissing is off the table."),
        Item(id: "redline_spine", name: "Redline spine", kind: Cyberware, weight: 1.5, value: 5200,
             implant: Some(Implant(fits: Spine, load: 3)),
             perks: [Attribute(Reflex, 1), Move(1)],
             desc: "A bus of fast wire down the back. The world slows down and so do your manners."),
        Item(id: "hardback_brace", name: "Hardback brace", kind: Cyberware, weight: 2.0, value: 2400,
             implant: Some(Implant(fits: Spine, load: 2)),
             perks: [Carry(10.0), Armor(1)],
             desc: "A titanium brace from neck to tailbone. Standing up straight is no longer optional."),
        Item(id: "drone_cradle", name: "Drone cradle", kind: Cyberware, weight: 1.8, value: 4100,
             implant: Some(Implant(fits: Back, load: 3)), grants: ["scout"],
             desc: "A cradle for a drone the size of a sparrow. It comes back when it's bored."),
        Item(id: "second_heart", name: "Second heart", kind: Cyberware, weight: 0.5, value: 4800,
             implant: Some(Implant(fits: Organs, load: 3)),
             perks: [HpMax(20)],
             desc: "A spare heart behind the real one. Twice the pressure, half the warranty."),
        Item(id: "filter_liver", name: "Filter liver", kind: Cyberware, weight: 0.4, value: 1400,
             implant: Some(Implant(fits: Organs, load: 1)),
             perks: [Resist(Toxin, 50)],
             desc: "You can't get drunk any more, and it shows."),
        Item(id: "capacitor_ribs", name: "Capacitor ribs", kind: Cyberware, weight: 0.9, value: 2600,
             implant: Some(Implant(fits: Organs, load: 2)),
             perks: [Focus(10)],
             desc: "Ribs that hold a charge. Hugs are a liability."),
        Item(id: "subdermal_mesh", name: "Subdermal mesh", kind: Cyberware, weight: 1.0, value: 2900,
             implant: Some(Implant(fits: Skin, load: 2)),
             perks: [Armor(1), Resist(Kinetic, 15)],
             desc: "Mesh under the skin. Knives go in a little way and think again."),
        Item(id: "ceramic_plating", name: "Ceramic plating", kind: Cyberware, weight: 4.5, value: 6800,
             implant: Some(Implant(fits: Skin, load: 4)),
             perks: [Armor(3), Resist(Kinetic, 30), Resist(Thermal, 15), Move(-1)],
             desc: "Plates in the chest and back. You knock on yourself for luck."),
        Item(id: "grounding_weave", name: "Grounding weave", kind: Cyberware, weight: 0.3, value: 1300,
             implant: Some(Implant(fits: Skin, load: 1)),
             perks: [Resist(Shock, 40)],
             desc: "Copper weave under the skin. You leak lightning into the floor."),
        Item(id: "smart_ink", name: "Smart ink", kind: Cyberware, weight: 0.0, value: 700,
             implant: Some(Implant(fits: Skin, load: 1)),
             perks: [Attribute(Cool, 1)],
             desc: "Living tattoos. Yours show the odds of the next fight."),
        Item(id: "surgeon_arm", name: "Surgeon arm", kind: Cyberware, weight: 3.5, value: 4400,
             implant: Some(Implant(fits: Arm, load: 3)), sockets: [Hand, Forearm],
             perks: [Attribute(Tech, 2)],
             desc: "Twelve joints a finger. Locks and wiring open like books."),
        Item(id: "wrecker_arm", name: "Wrecker arm", kind: Cyberware, weight: 6.0, value: 4900,
             implant: Some(Implant(fits: Arm, load: 4)), sockets: [Hand, Forearm],
             perks: [Attribute(Body, 2)],
             desc: "Demolition arm, filed down to street legal. Mostly."),
        Item(id: "toolfingers", name: "Toolfingers", kind: Cyberware, weight: 0.4, value: 1500,
             implant: Some(Implant(fits: Socket(Hand), load: 1)),
             perks: [Attribute(Tech, 1)],
             desc: "Each finger unscrews into a tool. Handshakes are an event."),
        Item(id: "monowire_spool", name: "Monowire spool", kind: Cyberware, weight: 0.3, value: 3600,
             implant: Some(Implant(fits: Socket(Forearm), load: 2)), grants: ["whip"],
             desc: "A wire too thin to see. Count your fingers after."),
        Item(id: "launcher_sleeve", name: "Launcher sleeve", kind: Cyberware, weight: 0.8, value: 2200,
             implant: Some(Implant(fits: Socket(Forearm), load: 2)),
             perks: [Throw(3)],
             desc: "A spring tube for grenades along the forearm."),
        Item(id: "sprinter_shanks", name: "Sprinter shanks", kind: Cyberware, weight: 5.0, value: 4600,
             implant: Some(Implant(fits: Legs, load: 3)),
             perks: [Move(1)],
             desc: "Carbon shins with a spring in them. Running is the easy part."),
        Item(id: "dog_legs", name: "Dog legs", kind: Cyberware, weight: 6.5, value: 6200,
             implant: Some(Implant(fits: Legs, load: 4)),
             perks: [Move(2)],
             desc: "Bent-back racing legs. Shoes are a memory."),
        Item(id: "choke_can", name: "Choke can", kind: Consumable, weight: 0.4, value: 200,
             use: Some(Throw(range: 7, arc: Lob, blast: Blast(radius: 2, damage: 8, stun: 0, harm: Toxin))),
             fx: [Throw, Haze, Number(tag: true)],
             desc: "A soup can of something the chemical plant denies making. Hold your breath; it won't help."),
        Item(id: "pawnshop_deck", name: "Pawnshop deck", kind: Deck, slot: Some(Deck), weight: 1.8, value: 1200,
             perks: [Attribute(Net, 1)], grants: ["netscan", "arc_trace"], deck: Some(DeckSpec(slots: 2, rating: 1, look: Pawn)),
             stickers: [(sticker: "sticker_no_future", x: 50, y: 10), (sticker: "sticker_dead_face", x: 45, y: 13)],
             desc: "Three previous owners, one of them dead. Boots in four seconds and runs hot."),
        Item(id: "rebuilt_deck", name: "Rebuilt pawn deck", kind: Deck, slot: Some(Deck), weight: 1.8, value: 6000,
             perks: [Attribute(Net, 2)], grants: ["netscan", "arc_trace"], deck: Some(DeckSpec(slots: 5, rating: 3, look: Pawn)), sockets: [Deck, Deck],
             stickers: [(sticker: "sticker_no_future", x: 50, y: 10), (sticker: "sticker_dead_face", x: 45, y: 13)],
             desc: "The pawnshop shell, gutted and rebuilt by someone who knew what they were doing. Five slots, and it still runs hot."),
        Item(id: "coldfin_1", name: "Coldfin vI", kind: Hardware, weight: 0.4, value: 800,
             hardware: Some(Hardware(fits: Deck, mods: [TraceCut(10)], look: ColdfinI)),
             desc: "Bolted-on fins and a copper pipe. The deck still runs hot, just less."),
        Item(id: "coldfin_2", name: "Coldfin vII", kind: Hardware, weight: 0.6, value: 1600,
             hardware: Some(Hardware(fits: Deck, mods: [TraceCut(20)], look: ColdfinII)),
             desc: "The same fins with a fan screwed over them. Somebody voided a warranty for this."),
        Item(id: "sidecar", name: "Sidecar co-processor", kind: Hardware, weight: 0.2, value: 900,
             hardware: Some(Hardware(fits: Deck, mods: [Power(1)], look: Sidecar)),
             desc: "A math board on gold fingers. Every turn it thinks a little ahead of you."),
        Item(id: "hushcan", name: "Hushcan", kind: Hardware, weight: 0.5, value: 700,
             hardware: Some(Hardware(fits: Muzzle, mods: [Attribute(Cool, 1)], look: Hushcan)),
             desc: "A baffle can that threads onto a muzzle. The shot still happens; the street just takes longer to turn round."),
        Item(id: "redeye", name: "Redeye sight", kind: Hardware, weight: 0.2, value: 550,
             hardware: Some(Hardware(fits: Rail, mods: [Attribute(Reflex, 1)], look: Redeye)),
             desc: "A red dot on coated glass. You stop aiming and start pointing."),
        // Stickers: decals for anything worn with a drawing; they change nothing but its look.
        Item(id: "sticker_no_future", name: "No Future", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " NO FUTURE ", ink: (232, 232, 236), ground: (255, 0, 200))),
             desc: "Magenta vinyl, white caps. Half the pawn decks in the Slab wear one; nobody knows who printed the first."),
        Item(id: "sticker_dead_face", name: "Dead face", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " x‿x ", ink: (0, 0, 0), ground: (255, 204, 0))),
             desc: "A hazard-yellow face with crosses for eyes, smiling about it anyway."),
        Item(id: "sticker_arasaka", name: "Arasaka", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " ◆ ARASAKA ", ink: (244, 244, 244), ground: (196, 20, 31))),
             desc: "Corporate red, a diamond and the name. Off a crate that fell off a truck that fell off a tower."),
        Item(id: "sticker_arasu_tek", name: "Arasu·Tek", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " ARASU·TEK ", ink: (196, 20, 31), ground: (232, 232, 236))),
             desc: "Promo vinyl from a product launch nobody came back from."),
        Item(id: "sticker_warranty_void", name: "Warranty void", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " WARRANTY VOID ", ink: (17, 17, 20), ground: (200, 204, 212))),
             desc: "WARRANTY VOID IF REMOVED. Too late for that."),
        Item(id: "sticker_flatline", name: "Flatline", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " FLATLINE ", ink: (10, 11, 13), ground: (125, 255, 58))),
             desc: "Acid green, the colour of the last thing a monitor shows."),
        Item(id: "sticker_jack_in", name: "Jack in", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " JACK IN ▸ ", ink: (0, 229, 255), ground: (0, 38, 44))),
             desc: "Cyan on black with an arrow, in case you forget which way the plug goes."),
        Item(id: "sticker_chrome_flesh", name: "Chrome > flesh", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " CHROME > FLESH ", ink: (232, 232, 236), ground: (46, 49, 56))),
             desc: "A ripperdoc's giveaway. The clinic closed; the slogan didn't."),
        Item(id: "sticker_deadbeef", name: "0xDEADBEEF", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " 0xDEADBEEF ", ink: (255, 176, 0), ground: (18, 12, 2))),
             desc: "Amber hex, for anyone who reads memory dumps for fun."),
        Item(id: "sticker_soul_not_found", name: "Soul not found", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " SOUL NOT FOUND ", ink: (255, 95, 210), ground: (20, 4, 15))),
             desc: "Error pink on black. Came free with a braindance."),
        Item(id: "sticker_sudo", name: "sudo rm -rf /", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " sudo rm -rf / ", ink: (80, 230, 120), ground: (3, 17, 10), bold: false)),
             desc: "Terminal green. Never run it; always stick it."),
        Item(id: "sticker_run_hot", name: "Run hot", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " RUN HOT ", ink: (10, 11, 13), ground: (255, 106, 0))),
             desc: "Safety orange. A pawn deck's motto, made official."),
        Item(id: "sticker_zero_day", name: "Zero day", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " ZERO DAY ", ink: (232, 232, 236), ground: (42, 42, 208))),
             desc: "Electric blue, for the hole nobody has patched yet."),
        Item(id: "sticker_slab_kings", name: "Slab Kings", kind: Sticker, weight: 0.0, value: 5,
             sticker: Some(Lettered(text: " SLAB KINGS ", ink: (255, 204, 0), ground: (10, 11, 13))),
             desc: "Gang yellow on black. Wearing it outside their blocks is a statement."),
        Item(id: "sticker_ice_breaker", name: "Ice breaker", kind: Sticker, weight: 0.0, value: 5,
