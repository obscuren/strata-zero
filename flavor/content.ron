        Item(id: "stim_patch", name: "Stim patch", kind: Consumable, weight: 0.05, value: 45, use: Some(Heal(15)),
             desc: "Twelve minutes of clarity, then the bill."),
        Item(id: "frag", name: "Frag", kind: Consumable, weight: 0.4, value: 180,
             use: Some(Throw(range: 8, arc: Lob, blast: Blast(radius: 2, damage: 12, stun: 0, harm: Kinetic))),
             fx: [Throw, Bloom, Chips, Number(tag: true)],
             desc: "A tin of nails with an opinion. Count to nothing."),
        Item(id: "flashbang", name: "Flashbang", kind: Consumable, weight: 0.3, value: 140,
             use: Some(Throw(range: 8, arc: Lob, blast: Blast(radius: 2, damage: 0, stun: 2, harm: Shock))),
             fx: [Throw, Whiteout, Number(tag: true)],
             desc: "Everything goes white, then everyone asks what happened."),
        Item(id: "emp_puck", name: "EMP puck", kind: Consumable, weight: 0.5, value: 260,
             use: Some(Throw(range: 7, arc: Shadow, blast: Blast(radius: 2, damage: 3, stun: 2, chrome: true, harm: Emp))),
             fx: [Throw, Shock, Tear, Spark, Number(tag: true)],
             desc: "Slides under things and takes their chrome offline for a breath."),
        Item(id: "satchel", name: "Satchel charge", kind: Consumable, weight: 1.2, value: 400,
             use: Some(Throw(range: 6, arc: Shadow, blast: Blast(radius: 3, damage: 16, stun: 0, fuse: 1, harm: Thermal))),
             fx: [Throw, Bloom, Chips, Number(tag: true)],
             desc: "A turn to think about it. Theirs, mostly."),
        Item(id: "scrap_servo", name: "Scrap servo", kind: Component, weight: 0.6, value: 30,
             desc: "Pulled from a vending arm. Still answers to the right voltage."),
        Item(id: "copper_coil", name: "Copper coil", kind: Component, weight: 0.2, value: 12,
             desc: "A spool of salvaged wire. Every fix starts here."),
        Item(id: "ratchet_receiver", name: "Stamped receiver", kind: Component, weight: 1.2, value: 300,
             desc: "The Ratchet's box: stamped steel, a serial number filed to fuzz."),
        Item(id: "ratchet_stock", name: "Wire stock", kind: Component, weight: 0.5, value: 80,
             desc: "Bent rod on a hinge. It folds, in theory."),
        Item(id: "ratchet_barrel", name: "Barrel 9×19", kind: Component, weight: 0.6, value: 220,
             desc: "A short tube with gold threads at the end, for whatever you screw on."),
        Item(id: "ratchet_mag", name: "Magazine", kind: Component, weight: 0.4, value: 60,
             desc: "Thirty rounds of 9×19 and a strip of label tape that says GOOD STUFF."),
        Item(id: "ratchet_trigger", name: "Trigger group", kind: Component, weight: 0.3, value: 140,
             desc: "Hammer, sear, spring, and a selector filed past safe."),
        Item(id: "burner_shard", name: "Burner shard", kind: Component, weight: 0.05, value: 25,
             desc: "A memory shard with one write cycle left."),
        Item(id: "bottle_caps", name: "Bottle caps", kind: Junk, weight: 0.1, value: 1,
             desc: "Someone in the Undercity collects these. You have not met them."),
        Item(id: "dead_phone", name: "Dead phone", kind: Junk, weight: 0.2, value: 5,
             desc: "Cracked screen, swollen battery, somebody's whole life inside."),
        Item(id: "ballistic_weave", name: "Ballistic weave", kind: Armor, slot: Some(Torso), weight: 3.0, value: 650, perks: [HpMax(8)],
             desc: "Layered weave that stops the first burst and remembers the second."),
        Item(id: "scrappers_roll", name: "Scrapper's roll", kind: Component, weight: 1.5, value: 140,
             desc: "Drivers, picks, a soldering iron that runs off a stolen cell."),
        Item(id: "burner_schematic", name: "Burner schematic", kind: Component, weight: 0.05, value: 90,
             desc: "One-shot plans etched on a shard that will not survive the read."),
        // Programs: loaded into a deck's slots, run against nodes in the Net.
        Item(id: "crack", name: "Crack", kind: Program, weight: 0.0, value: 150,
             program: Some(Program(op: Crack, rating: 1, size: 1, noise: 4, work: 3)),
             desc: "Brute force with manners. Opens anything that answers, loudly."),
        Item(id: "spoof", name: "Spoof", kind: Program, weight: 0.0, value: 200,
             program: Some(Program(op: Spoof, rating: 1, size: 1, noise: 2, work: 2)),
             desc: "Tells a lock or a lift it already let you through."),
        Item(id: "blind", name: "Blind", kind: Program, weight: 0.0, value: 120,
             program: Some(Program(op: Blind, rating: 1, size: 1, noise: 2, work: 2)),
             desc: "A camera keeps recording. Just not you."),
        Item(id: "copy", name: "Copy", kind: Program, weight: 0.0, value: 250,
             program: Some(Program(op: Copy, rating: 1, size: 1, noise: 3, work: 4)),
             desc: "Everything on the node, in the time it takes to notice."),
        Item(id: "backdoor", name: "Backdoor", kind: Program, weight: 0.0, value: 600,
             program: Some(Program(op: Backdoor, rating: 1, size: 2, noise: 2, work: 5)),
             desc: "A door only you know about, cut into the server's floor."),
        Item(id: "crack_2", name: "Crack II", kind: Program, weight: 0.0, value: 900,
             program: Some(Program(op: Crack, rating: 2, size: 2, noise: 3, work: 3)),
             desc: "The same hammer, swung by someone who has done this before."),
        Item(id: "copy_2", name: "Copy II", kind: Program, weight: 0.0, value: 1100,
             program: Some(Program(op: Copy, rating: 2, size: 2, noise: 2, work: 3)),
             desc: "Faster, quieter, and it leaves the checksums alone."),
        Item(id: "attack", name: "Attack", kind: Program, weight: 0.0, value: 400,
             program: Some(Program(op: Attack, rating: 1, size: 1, noise: 3, work: 1)),
             desc: "A spike of bad arithmetic aimed at whatever is looking at you."),
        Item(id: "shield", name: "Shield", kind: Program, weight: 0.0, value: 300,
             program: Some(Program(op: Shield, rating: 1, size: 1, noise: 1, work: 1)),
             desc: "Soaks the next hit. Then it is gone."),
        Item(id: "mask", name: "Mask", kind: Program, weight: 0.0, value: 350,
             program: Some(Program(op: Mask, rating: 1, size: 1, noise: 1, work: 1)),
             desc: "You are still there. You are just harder to see."),
        Item(id: "paydata", name: "Paydata shard", kind: Component, weight: 0.05, value: 300,
             desc: "Somebody's quarter, somebody's passwords, somebody's problem. A fixer will know whose."),
        Item(id: "vault_data", name: "Vault dump", kind: Component, weight: 0.05, value: 1500,
             desc: "A whole vault on one shard. Warm to the touch, which it should not be."),
        Item(id: "sealed_package", name: "Sealed package", kind: Component, weight: 0.5, value: 0,
             desc: "Taped shut. Heavier than it looks. Not yours to open."),
    ],
    skills: [
        Skill(id: "blades", name: "Blades", attribute: Reflex, needs: [(Reflex, 4)], desc: "Knives, shivs and anything with an edge."),
        Skill(id: "handguns", name: "Handguns", attribute: Reflex, needs: [(Reflex, 4)], desc: "Pistols and machine pistols at street range."),
        Skill(id: "stealth", name: "Stealth", attribute: Cool, needs: [(Cool, 4)], desc: "Not being where the cameras are looking."),
        Skill(id: "hacking", name: "Hacking", attribute: Net, needs: [(Net, 4)], desc: "Getting into systems from the inside of the Net."),
        Skill(id: "electronics", name: "Electronics", attribute: Tech, needs: [(Tech, 4)], desc: "Building and fixing hardware at the bench."),
        Skill(id: "streetwise", name: "Streetwise", attribute: Cool, needs: [(Cool, 4)], desc: "Who sells what, who owes whom, which alley to skip."),
        Skill(id: "athletics", name: "Athletics", attribute: Body, needs: [(Body, 4)], desc: "Running, climbing and taking a fall."),
        Skill(id: "medtech", name: "Medtech", attribute: Tech, needs: [(Tech, 4)], desc: "Patches, stims and keeping blood inside people."),
        Skill(id: "ice_breaker", name: "ICE breaker", attribute: Net, needs: [(Net, 5)], desc: "You find the seam in the ICE before it finds you."),
        Skill(id: "vault_run", name: "Vault run", attribute: Net, needs: [(Net, 7)], desc: "You go past the vault door and come back with the vault."),
        Skill(id: "scrapcraft", name: "Scrapcraft", attribute: Tech, needs: [(Tech, 5)], desc: "Two broken things make one that works, mostly."),
        Skill(id: "overclock", name: "Overclock", attribute: Tech, needs: [(Tech, 7)], desc: "Everything you touch runs hot and fast and short."),
        Skill(id: "longarm", name: "Longarm", attribute: Reflex, needs: [(Reflex, 5)], desc: "Rifles and the patience to use them."),
        Skill(id: "snapshot", name: "Snapshot", attribute: Reflex, needs: [(Reflex, 7)], desc: "The first round leaves before the thought does."),
        Skill(id: "close_work", name: "Close work", attribute: Reflex, needs: [(Reflex, 5)], desc: "Inside the swing, under the guard, done."),
        Skill(id: "riposte", name: "Riposte", attribute: Reflex, needs: [(Reflex, 7)], desc: "They cut, you cut back, they stop."),
        Skill(id: "lockpick", name: "Lockpick", attribute: Cool, needs: [(Cool, 5)], desc: "Doors are a suggestion."),
        Skill(id: "vanish", name: "Vanish", attribute: Cool, needs: [(Cool, 7)], desc: "You were never here, and the footage agrees."),
        Skill(id: "haggle", name: "Haggle", attribute: Cool, needs: [(Cool, 5)], desc: "Every price has a second price."),
        Skill(id: "fixers_ear", name: "Fixer's ear", attribute: Cool, needs: [(Cool, 7)], desc: "You hear the job before it is posted."),
        Skill(id: "field_patch", name: "Field patch", attribute: Tech, needs: [(Tech, 5)], desc: "Tape, gel and a steady hand, on the run."),
        Skill(id: "stim_cocktail", name: "Stim cocktail", attribute: Tech, needs: [(Tech, 7)], desc: "Mix it right and the night lasts twice as long."),
        Skill(id: "freerun", name: "Freerun", attribute: Body, needs: [(Body, 5)], desc: "Walls are a slower kind of floor."),
        Skill(id: "second_wind", name: "Second wind", attribute: Body, needs: [(Body, 7)], desc: "The point where others stop is where you start."),
    ],
    // Five trees, one per attribute: tiers from the bottom, two talents a tier, a capstone on
    // the fifth. A talent's prerequisite sits straight below it. Flags are promises the
    // combat and shop systems read later.
    trees: [
        Tree(attribute: Body, name: "MEAT", line: "the body is the first machine",
             tiers: [["thick_skin", "long_haul"], ["second_lung", "iron_grip"], ["pain_editor", "wall_runner"],
                     ["juggernaut", "cat_fall"], ["meat_machine"]]),
        Tree(attribute: Reflex, name: "EDGE", line: "the half second that decides it",
             tiers: [["quick_draw", "steady_hand"], ["double_tap", "backstab"], ["hair_trigger", "counter_cut"],
                     ["bullet_time", "razor_wire"], ["half_second"]]),
        Tree(attribute: Tech, name: "WRENCH", line: "chrome does what you tell it",
             tiers: [["solder_hand", "field_medic"], ["overclocker", "stim_chemist"], ["scrap_eye", "trauma_kit"],
                     ["tinker", "chrome_whisperer"], ["machine_ghost"]]),
        Tree(attribute: Cool, name: "STREET", line: "the city owes you",
             tiers: [["ghost", "silver_tongue"], ["shadow_step", "ear_to_the_ground"], ["skeleton_key", "cold_read"],
                     ["smoke", "ice_cold"], ["the_name"]]),
        Tree(attribute: Net, name: "ICE", line: "the deep end of the grid",
             tiers: [["ice_pick", "wide_band"], ["deep_dive", "handshake"], ["arc_welder", "cold_boot"],
                     ["black_ice", "null_route"], ["deep_end"]]),
    ],
    talents: [
        // MEAT
