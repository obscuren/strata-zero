        mass: ['█', '▓', '▒', '░'],
        net: ['◇', '◆', '⬡', '⌗', '▪', '◈'],
    ),
    devices: [
        ("municipal", DeviceStyle(badge: "MUNI-OS", body: (40, 46, 54), edge: None, glass: (6, 18, 22), text: None, text_dim: (0, 120, 135),
            keys_lit: true, scanlines: true, cracked: false, dead: 0, flicker: 0, cps: 60,
            boot: ["MUNI-OS 4.1 · {PLACE} SUBNET", "MEMORY CHECK OK", "READY"], denied: None)),
        ("megacorp", DeviceStyle(badge: "CORP/OS", body: (206, 212, 220), edge: Some((244, 248, 252)), glass: (2, 4, 8), text: Some((200, 230, 255)), text_dim: (110, 140, 170),
            keys_lit: true, scanlines: false, cracked: false, dead: 0, flicker: 0, cps: 80,
            boot: ["{PLACE} SECURE NODE · CORP/OS 9", "INTEGRITY VERIFIED", "WELCOME"], denied: Some("YOUR CLEARANCE DOES NOT PERMIT THIS ACTION"))),
