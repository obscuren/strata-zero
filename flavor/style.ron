            boot: ["{PLACE} NET ~ STAY A WHILE ~", "ALL SYSTEMS LIT", "READY"], denied: None)),
        ("street", DeviceStyle(badge: "MUNI-OS", body: (28, 26, 30), edge: Some((120, 62, 40)), glass: (20, 14, 6), text: Some((255, 176, 0)), text_dim: (140, 96, 20),
            keys_lit: false, scanlines: true, cracked: true, dead: 3, flicker: 110, cps: 40,
            boot: ["SYS BOOT.. OK?", "MEM CHK 64K", "REDY"], denied: None)),
    ],
)
