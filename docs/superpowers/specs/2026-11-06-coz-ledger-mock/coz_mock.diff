+// ---- Throwaway: Coz's book mocks (#4, #5). Not committed. ----
+
+const COZ_STREET: Place = Place::Stratum(StratumKind::Street);
+
+/// The morning after read, the doctor seen, the shard known, the clock on `hh:mm`: the
+/// ledger waits on Coz.
+fn coz_evening(hh: u64, mm: u64, skill: Option<&str>) -> AppState {
+    let mut st = seren_has_written();
+    st.missions.daze = None;
+    if let Some(s) = skill {
+        st.character.skills.insert(game::SkillId::new(s));
+    }
+    crate::missions::tests::open_the_package(&mut st);
+    st.missions.read.insert("ledger_shard".to_string());
+    crate::missions::tick(&mut st);
+    let doctor = st.book.missions.iter().position(|m| m.id == "doctor").unwrap();
+    st.missions.runs[doctor].state = crate::missions::RunState::Done { at: 0 };
+    let ahead = (hh * 60 + mm + 1440 - u64::from(st.minute_of_day())) % 1440;
+    let (city, world) = (st.city.as_ref().unwrap(), st.world.as_mut().unwrap());
+    world.advance(city, world.tick() + ahead * sim::TICKS_PER_MINUTE);
+    crate::missions::tick(&mut st);
+    // The day's leftovers out of the frame: its mail read, its jobs gone, its log.
+    for m in st.journal.mails.iter_mut() {
+        m.read = true;
+    }
+    st.mail_seen = st.journal.mails.len();
+    st.jobs.list.clear();
+    st.log = Default::default();
+    st
+}
+
+/// Coz on his corner, and a free street tile `d` tiles off him (beside him for 1).
+fn near_coz(st: &mut AppState, d: i32) -> (sim::PersonId, Pos) {
+    let coz = crate::missions::person_of(st, "coz").expect("coz is cast");
+    let (place, at) = crate::interiors::drawn_at(st, coz).expect("coz is drawn");
+    assert_eq!(place, COZ_STREET, "coz on his corner");
+    let spot = if d <= 1 {
+        crate::missions::marks::beside_tile(st, place, at, None)
+            .expect("a tile beside coz")
+            .1
+    } else {
+        let city = st.city.as_ref().unwrap();
+        let world = st.world.as_ref().unwrap();
+        let around = |p: Pos| {
+            citygen::Rect::new(p.x, p.y, 1, 1)
+                .grow(10)
+                .iter()
+                .filter(|&q| city.walkable(StratumKind::Street, q))
+                .count()
+        };
+        citygen::Rect::new(at.x, at.y, 1, 1)
+            .grow(d)
+            .iter()
+            .filter(|p| p.chebyshev(at) == d)
+            .filter(|&p| city.walkable(StratumKind::Street, p) && world.person_at(p).is_none())
+            .max_by_key(|&p| around(p))
+            .expect("a free tile off coz")
+    };
+    crate::missions::tests::on_street(st, spot);
+    (coz, at)
+}
+
+/// A holo ad on the street near `from`, with you a few tiles off it, seeing it.
+fn coz_by_an_ad(st: &mut AppState, from: Pos) -> Pos {
+    let city = st.city.clone().unwrap();
+    let mut ads: Vec<Pos> = citygen::Rect::new(from.x, from.y, 1, 1)
+        .grow(40)
+        .iter()
+        .filter(|&p| {
+            city.tile(StratumKind::Street, p)
+                .is_some_and(|t| t.feature == Some(citygen::Feature::HoloAd))
+        })
+        .collect();
+    ads.sort_by_key(|p| p.chebyshev(from));
+    for ad in ads {
+        for d in 3..=5 {
+            for (dx, dy) in [(0, 1), (0, -1), (1, 0), (-1, 0)] {
+                let spot = ad.offset(dx * d, dy * d);
+                let free = city.walkable(StratumKind::Street, spot)
+                    && st.world.as_ref().unwrap().person_at(spot).is_none();
+                if !free {
+                    continue;
+                }
+                crate::missions::tests::on_street(st, spot);
+                let seen = st.player.as_ref().unwrap().vis().get(ad)
+                    == Some(&crate::walker::Visibility::Visible);
+                if seen {
+                    return ad;
+                }
+            }
+        }
+    }
+    panic!("no holo ad near coz's corner");
+}
+
+fn coz_deck_on(st: &mut AppState, tab: char) -> Deck {
+    let mut deck = Deck::new(st.tick);
+    deck.update(st, &[key(KeyCode::Char(tab))]);
+    st.tick += 200;
+    while st.tick % 90 < 3 {
+        st.tick += 1;
+    }
+    deck
+}
