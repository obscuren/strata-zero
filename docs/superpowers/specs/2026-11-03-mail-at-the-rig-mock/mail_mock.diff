+/// MOCK: mail in the rig's terminal: the boot says what waits, `mail` lists the inbox,
+/// `mail new` reads the next new one.
+#[test]
+#[ignore]
+fn term_mail_mock() {
+    let mut st = crate::missions::tests::the_morning_call();
+    crate::missions::tests::the_news_is_on(&mut st);
+    crate::missions::news::switch_off(&mut st);
+    st.missions.daze = None;
+    st.missions.asides.clear();
+    for m in st.journal.mails.iter_mut() {
+        m.read = m.subject != "the news";
+    }
+    st.mail_seen = st.journal.mails.len();
+    st.mail_pill = None;
+    let map = by_the_set(&mut st);
+    let home = st.home.unwrap();
+    let size = (120u16, 40u16);
+    let mut term = Terminal::open(&mut st, HostId::Rig, (home.place(), home.home.rig));
+    st.tick += 10_000;
+    term.update(&mut st, &[]);
+    shot_stack("term_boot_120x40", &st, &[&map, &term], size);
+    type_lines(&mut st, &mut term, &["mail"]);
+    st.tick += 10_000;
+    term.update(&mut st, &[]);
+    shot_stack("term_inbox_120x40", &st, &[&map, &term], size);
+    type_lines(&mut st, &mut term, &["clear", "mail new"]);
+    st.tick += 10_000;
+    term.update(&mut st, &[]);
+    shot_stack("term_read_120x40", &st, &[&map, &term], size);
+    type_lines(&mut st, &mut term, &["clear"]);
+    st.tick += 10_000;
+    term.update(&mut st, &[]);
+    shot_stack("term_blank_120x40", &st, &[&map, &term], size);
+}
