+#[test]
+#[ignore]
+fn keyjack_art_mock() {
+    for (w, h) in [(120u16, 40u16), (100, 30)] {
+        let size = (w, h);
+        // The clip key on the pad, fused and not.
+        for (name, fused) in [("clip", true), ("clip_nofuse", false)] {
+            let mut st = state_home();
+            let map = MapScreen::walking(&mut st);
+            crate::jobs::first_favour(&mut st);
+            st.tick += 200;
+            let (b, level, number, _) = crate::jobs::first_fetch(&st).expect("the favour");
+            let pad = Keypad::open(&st, b, level, number);
+            let clip = MockClip { pad, fused };
+            shot_stack(&format!("kj_{name}_{w}x{h}"), &st, &[&map, &clip], size);
+        }
+        // The Keyjack on its blueprint, and opened up.
+        for (name, mode, fuse, tray) in [
+            ("front", 0u8, Some(true), None),
+            ("back", 1, Some(true), None),
+            ("back_tray", 1, Some(true), Some(1usize)),
+            ("back_blown", 1, Some(false), None),
+        ] {
+            let mut st = state_home();
+            let map = MapScreen::walking(&mut st);
+            let mut deck = Deck::new(st.tick);
+            deck.update(&mut st, &[key(KeyCode::Char('3'))]);
+            st.tick += 200;
+            if st.tick % 90 < 3 {
+                st.tick += 3;
+            }
+            let window = Blueprint::open(&st, ItemId::new("copper_coil"), false, None);
+            let mock = MockKeyjack {
+                window,
+                mode,
+                fuse,
+                tray,
+            };
+            shot_stack(&format!("kj_{name}_{w}x{h}"), &st, &[&map, &deck, &mock], size);
+        }
+    }
