+/// A blueprint window over the deck, its inside replaced with the Keyjack.
+struct MockKeyjack {
+    window: Blueprint,
+    mode: u8,
+    fuse: Option<bool>,
+    tray: Option<usize>,
+}
+
+const KJ_FUSES: [(&str, &str); 4] = [
+    ("STOCK FUSE", "no bonus"),
+    ("CERAMIC FUSE", "faults +1"),
+    ("SLOW-BLOW", "marker slower"),
+    ("WIDEBAND", "zones +1"),
+];
+
+impl Screen for MockKeyjack {
+    fn update(&mut self, _: &mut AppState, _: &[crossterm::event::KeyEvent]) -> crate::app::ScreenCmd {
+        crate::app::ScreenCmd::Stay
+    }
+    fn draw(&self, st: &AppState, f: &mut ratatui::Frame) {
+        self.window.draw(st, f);
+        let r = Blueprint::rect(f.area());
+        let buf = f.buffer_mut();
+        // The window's own frame and title style, sampled before the inside goes.
+        let title_style = buf[(r.x + 3, r.y)].style();
+        let band = buf[(r.right() - 3, r.y)].clone();
+        let hint_style = buf[(r.x + 2, r.bottom() - 2)].style();
+        let inner_bg = buf[(r.x + 2, r.y + 2)].bg;
+        for x in r.x + 1..r.right() - 1 {
+            buf[(x, r.y)] = band.clone();
+        }
+        let title = if self.mode == 0 {
+            " BLUEPRINT · KEYJACK "
+        } else {
+            " MODDING · KEYJACK "
+        };
+        buf.set_string(r.x + 2, r.y, title, title_style);
+        for y in r.y + 1..r.bottom() - 1 {
+            for x in r.x + 1..r.right() - 1 {
+                let c = &mut buf[(x, y)];
+                c.reset();
+                c.set_char(' ').set_bg(inner_bg);
+            }
+        }
+        let ox = r.x + (r.width - kj::W) / 2;
+        let oy = r.y + if r.height >= 32 { 6 } else { 3 };
+        {
+            let mut pen = crate::ui::cyberdeck::Pen {
+                clip: r,
+                buf: &mut *buf,
+                ox,
+                oy,
+            };
+            if self.mode == 0 {
+                kj::front(&mut pen);
+            } else {
+                kj::back(&mut pen, self.fuse);
+            }
+        }
+        let style = |fg: Color, bold: bool| {
+            let s = ratatui::style::Style::default().fg(fg).bg(inner_bg);
+            if bold { s.add_modifier(Modifier::BOLD) } else { s }
+        };
+        let cyan = Color::Rgb(0, 229, 255);
+        let text = Color::Rgb(205, 212, 222);
+        let dim = Color::Rgb(110, 120, 135);
+        let hint_y = r.bottom() - 2;
+        if self.mode == 0 {
+            let dy = oy + kj::H + 1;
+            buf.set_string(r.x + 4, dy, "A slab on a lead that clips onto a door's keypad and", style(text, false));
+            buf.set_string(r.x + 4, dy + 1, "works its four digits out with you, a beat at a time.", style(text, false));
+            buf.set_string(r.x + 4, dy + 3, "fuse", style(dim, false));
+            buf.set_string(r.x + 9, dy + 3, "STOCK", style(cyan, true));
+            buf.set_string(r.x + 15, dy + 3, "· faults 3 · zones as rated", style(dim, false));
+            buf.set_string(r.x + 2, hint_y, "m mod · s stickers · esc close", hint_style);
+        } else {
+            // The socket's dashed box round the fuse holder.
+            let (sx, sy, sw, sh) = (ox + 20, oy + 9, 19, 5);
+            let dash = |buf: &mut Buffer, x: u16, y: u16, ch: &str| {
+                let under = buf[(x, y)].bg;
+                buf.set_string(x, y, ch, style(cyan, false).bg(under));
+            };
+            for x in sx..sx + sw {
+                dash(buf, x, sy, "╌");
+                dash(buf, x, sy + sh - 1, "╌");
+            }
+            for y in sy..sy + sh {
+                dash(buf, sx, y, "╎");
+                dash(buf, sx + sw - 1, y, "╎");
+            }
+            let info_y = hint_y - 2;
+            if let Some(sel) = self.tray {
+                let ty = info_y - 4;
+                buf.set_string(r.x + 4, ty, "FUSES", style(dim, true));
+                let mut x = r.x + 12;
+                for (i, (name, what)) in KJ_FUSES.iter().enumerate() {
+                    let card = Color::Rgb(58, 63, 72);
+                    let w = 16u16;
+                    for dx in 0..w {
+                        buf.set_string(x + dx, ty, " ", style(text, false).bg(card));
+                        buf.set_string(x + dx, ty + 1, " ", style(text, false).bg(card));
+                    }
+                    buf.set_string(x + 1, ty, name, style(Color::Rgb(235, 240, 245), true).bg(card));
+                    buf.set_string(x + 1, ty + 1, what, style(text, false).bg(card));
+                    if i == sel {
+                        for (cx, cy, ch) in [
+                            (x - 1, ty - 1, "┏"),
+                            (x + w, ty - 1, "┓"),
+                            (x - 1, ty + 2, "┗"),
+                            (x + w, ty + 2, "┛"),
+                        ] {
+                            buf.set_string(cx, cy, ch, style(cyan, false));
+                        }
+                    }
+                    x += w + 2;
+                }
+                let (name, what) = KJ_FUSES[sel];
+                buf.set_string(r.x + 2, info_y, name, style(cyan, true));
+                let after = r.x + 3 + name.chars().count() as u16;
+                buf.set_string(after, info_y, &format!("▸ socket FUSE · {what}"), style(text, false));
+                buf.set_string(r.x + 2, hint_y, "↔ fuses · space fit · esc back", hint_style);
+            } else {
+                buf.set_string(r.x + 2, info_y, "SOCKET FUSE", style(cyan, true));
+                let line = match self.fuse {
+                    Some(true) => "▸ Stock fuse · no bonus",
+                    Some(false) => "▸ blown · the Keyjack won't run until a fuse goes in",
+                    None => "▸ empty · the Keyjack won't run",
+                };
+                buf.set_string(r.x + 14, info_y, line, style(text, false));
+                buf.set_string(r.x + 2, hint_y, "space choose · m inspect · esc close", hint_style);
+            }
+        }
+    }
+}
+
+/// The door's pad with the clip key under it.
+struct MockClip {
+    pad: Keypad,
+    fused: bool,
+}
+
+impl Screen for MockClip {
+    fn update(&mut self, _: &mut AppState, _: &[crossterm::event::KeyEvent]) -> crate::app::ScreenCmd {
+        crate::app::ScreenCmd::Stay
+    }
+    fn draw(&self, st: &AppState, f: &mut ratatui::Frame) {
+        self.pad.draw(st, f);
+        let pad = self.pad.rect(f.area());
+        let buf = f.buffer_mut();
+        let bg = Color::Rgb(18, 16, 26);
+        let y = pad.bottom();
+        let (key, text, fg) = if self.fused {
+            ("k", " clip the keyjack ", Color::Rgb(205, 212, 222))
+        } else {
+            ("k", " keyjack · no fuse ", Color::Rgb(90, 96, 110))
+        };
+        let w = 3 + text.chars().count() as u16;
+        let x = pad.x + (pad.width.saturating_sub(w)) / 2;
+        let key_fg = if self.fused {
+            Color::Rgb(255, 0, 200)
+        } else {
+            Color::Rgb(90, 60, 85)
+        };
+        buf.set_string(
+            x,
+            y,
+            format!(" {key} "),
+            ratatui::style::Style::default()
+                .fg(key_fg)
+                .bg(bg)
+                .add_modifier(Modifier::BOLD),
+        );
+        buf.set_string(x + 3, y, text, ratatui::style::Style::default().fg(fg).bg(bg));
+    }
+}
