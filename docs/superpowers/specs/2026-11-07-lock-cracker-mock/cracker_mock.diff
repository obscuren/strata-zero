+// ---- Throwaway: lock cracker mocks (#6). Not committed. ----
+
+#[derive(Clone, Copy, PartialEq)]
+enum CrackLook {
+    Slab,
+    Leech,
+    Scope,
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum CrackState {
+    Run,
+    Miss,
+    Fried,
+    Cracked,
+}
+
+struct MockCracker {
+    pad: Keypad,
+    look: CrackLook,
+    state: CrackState,
+    code: [u8; 4],
+    found: usize,
+    misses: u8,
+    marker: u16,
+}
+
+const CR_BAR: u16 = 18;
+/// Each beat's zone: its left cell and its width, narrower every hit.
+const CR_ZONES: [(u16, u16); 4] = [(6, 7), (10, 5), (3, 3), (12, 2)];
+
+fn cr_rgb(r: u8, g: u8, b: u8) -> Color {
+    Color::Rgb(r, g, b)
+}
+
+fn cr_put(buf: &mut Buffer, x: u16, y: u16, s: &str, fg: Color, bg: Color, bold: bool) {
+    let mut style = ratatui::style::Style::default().fg(fg).bg(bg);
+    if bold {
+        style = style.add_modifier(Modifier::BOLD);
+    }
+    buf.set_string(x, y, s, style);
+}
+
+fn cr_fill(buf: &mut Buffer, r: Rect, bg: Color) {
+    for y in r.y..r.bottom() {
+        for x in r.x..r.right() {
+            let c = &mut buf[(x, y)];
+            c.reset();
+            c.set_char(' ').set_bg(bg);
+        }
+    }
+}
+
+fn cr_frame(buf: &mut Buffer, r: Rect, fg: Color, bg: Color, heavy: bool) {
+    let (h, v, tl, tr, bl, br) = if heavy {
+        ("━", "┃", "┏", "┓", "┗", "┛")
+    } else {
+        ("─", "│", "┌", "┐", "└", "┘")
+    };
+    for x in r.x + 1..r.right() - 1 {
+        cr_put(buf, x, r.y, h, fg, bg, false);
+        cr_put(buf, x, r.bottom() - 1, h, fg, bg, false);
+    }
+    for y in r.y + 1..r.bottom() - 1 {
+        cr_put(buf, r.x, y, v, fg, bg, false);
+        cr_put(buf, r.right() - 1, y, v, fg, bg, false);
+    }
+    cr_put(buf, r.x, r.y, tl, fg, bg, false);
+    cr_put(buf, r.right() - 1, r.y, tr, fg, bg, false);
+    cr_put(buf, r.x, r.bottom() - 1, bl, fg, bg, false);
+    cr_put(buf, r.right() - 1, r.bottom() - 1, br, fg, bg, false);
+}
+
+impl MockCracker {
+    fn beat(&self) -> usize {
+        self.found.min(3)
+    }
+
+    /// The bar: a track, the zone, the marker; red all over on a miss.
+    #[allow(clippy::too_many_arguments)]
+    fn bar(&self, buf: &mut Buffer, x: u16, y: u16, track: Color, zone: Color, mark: Color, bg: Color) {
+        self.bar_caps(buf, x, y, track, zone, mark, bg, true);
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn bar_caps(&self, buf: &mut Buffer, x: u16, y: u16, track: Color, zone: Color, mark: Color, bg: Color, caps: bool) {
+        let (at, w) = CR_ZONES[self.beat()];
+        let miss = self.state == CrackState::Miss;
+        let x = if caps { x } else { x.saturating_sub(1) };
+        if caps {
+            cr_put(buf, x, y, "▕", track, bg, false);
+        }
+        for i in 0..CR_BAR {
+            let in_zone = i >= at && i < at + w;
+            let (ch, fg) = if i == self.marker && self.state == CrackState::Run {
+                ("█", mark)
+            } else if in_zone {
+                ("▒", if miss { cr_rgb(255, 40, 60) } else { zone })
+            } else {
+                ("─", if miss { cr_rgb(120, 20, 30) } else { track })
+            };
+            cr_put(buf, x + 1 + i, y, ch, fg, bg, false);
+        }
+        if caps {
+            cr_put(buf, x + 1 + CR_BAR, y, "▏", track, bg, false);
+        }
+    }
+
+    /// `4 7 _ _`: the digits cracked so far.
+    fn digits(&self) -> String {
+        (0..4)
+            .map(|i| {
+                if i < self.found {
+                    self.code[i].to_string()
+                } else {
+                    "_".to_string()
+                }
+            })
+            .collect::<Vec<_>>()
+            .join(" ")
+    }
+
+    fn leds(&self, buf: &mut Buffer, x: u16, y: u16, on: Color, off: Color, bg: Color) {
+        for i in 0..3u16 {
+            let lit = i < self.misses as u16;
+            cr_put(buf, x + i * 2, y, "●", if lit { on } else { off }, bg, false);
+        }
+    }
+
+    fn slab(&self, buf: &mut Buffer, pad: Rect) {
+        let body = cr_rgb(18, 16, 26);
+        let edge = cr_rgb(255, 0, 200);
+        let lcd = cr_rgb(4, 22, 12);
+        let on = cr_rgb(90, 255, 150);
+        let dim = cr_rgb(22, 90, 50);
+        let r = Rect::new(pad.right() + 3, pad.y + 2, 26, 13);
+        // The lead: clipped to the pad's edge, run to the slab.
+        for x in pad.right()..r.x {
+            cr_put(buf, x, r.y + 4, "╍", cr_rgb(170, 0, 130), cr_rgb(10, 8, 14), false);
+        }
+        cr_put(buf, pad.right() - 1, r.y + 4, "╡", edge, cr_rgb(40, 46, 54), true);
+        cr_fill(buf, r, body);
+        cr_frame(buf, r, edge, body, true);
+        cr_put(buf, r.x, r.y + 4, "┫", edge, body, true);
+        cr_put(buf, r.x + 2, r.y + 1, "▞▚ KEYJACK", edge, body, true);
+        cr_put(buf, r.x + 2, r.y + 10, "└┬┘ ╶─┴─╴ ┌┴┐ ╶┬╴ └─┘", cr_rgb(60, 30, 70), body, false);
+        cr_put(buf, r.x + 19, r.y + 2, "▚▞▚▞▚", cr_rgb(70, 20, 70), body, false);
+        cr_put(buf, r.x + 14, r.y + 1, "KJ-4", cr_rgb(150, 140, 170), body, false);
+        let led = match self.state {
+            CrackState::Cracked => cr_rgb(80, 255, 140),
+            CrackState::Fried | CrackState::Miss => cr_rgb(255, 40, 60),
+            CrackState::Run => cr_rgb(255, 180, 40),
+        };
+        cr_put(buf, r.right() - 3, r.y + 1, "●", led, body, false);
+        let glass = Rect::new(r.x + 2, r.y + 3, r.width - 4, 5);
+        cr_fill(buf, glass, lcd);
+        cr_frame(buf, glass, dim, lcd, false);
+        match self.state {
+            CrackState::Fried => {
+                cr_put(buf, glass.x + 2, glass.y + 1, "▒▒░ ▒░▒▒░▒ ░▒▒▒░", cr_rgb(40, 50, 40), lcd, false);
+                cr_put(buf, glass.x + 6, glass.y + 2, "FUSE  BLOWN", cr_rgb(255, 40, 60), lcd, true);
+                cr_put(buf, glass.x + 2, glass.y + 3, "░▒░▒▒ ░▒  ▒▒░▒░", cr_rgb(40, 50, 40), lcd, false);
+            }
+            CrackState::Cracked => {
+                self.bar(buf, glass.x + 1, glass.y + 1, dim, on, on, lcd);
+                cr_put(buf, glass.x + 3, glass.y + 3, &self.digits(), on, lcd, true);
+                cr_put(buf, glass.x + 13, glass.y + 3, "OPEN", on, lcd, true);
+            }
+            _ => {
+                self.bar(buf, glass.x + 1, glass.y + 1, dim, on, cr_rgb(230, 255, 235), lcd);
+                cr_put(buf, glass.x + 3, glass.y + 3, &self.digits(), on, lcd, true);
+                let tag = if self.state == CrackState::Miss { "ERR" } else { "   " };
+                cr_put(buf, glass.x + 15, glass.y + 3, tag, cr_rgb(255, 40, 60), lcd, true);
+            }
+        }
+        cr_put(buf, r.x + 2, r.y + 9, "FAULT", cr_rgb(150, 140, 170), body, false);
+        self.leds(buf, r.x + 8, r.y + 9, cr_rgb(255, 40, 60), cr_rgb(70, 20, 30), body);
+        cr_put(
+            buf,
+            r.x + 16,
+            r.y + 9,
+            &format!("BEAT {}/4", (self.found + 1).min(4)),
+            cr_rgb(150, 140, 170),
+            body,
+            false,
+        );
+        cr_put(buf, r.x + 2, r.y + 11, "space", edge, body, true);
+        cr_put(buf, r.x + 8, r.y + 11, "strike", cr_rgb(150, 140, 170), body, false);
+        cr_put(buf, r.x + 16, r.y + 11, "esc", edge, body, true);
+        cr_put(buf, r.x + 20, r.y + 11, "pull", cr_rgb(150, 140, 170), body, false);
+    }
+
+    fn leech(&self, buf: &mut Buffer, pad: Rect) {
+        let body = cr_rgb(24, 22, 30);
+        let edge = cr_rgb(255, 0, 200);
+        let glass_bg = cr_rgb(6, 18, 22);
+        let on = cr_rgb(255, 60, 210);
+        let dim = cr_rgb(90, 20, 75);
+        // The clamp over the pad's crown, its legs bitten into the glass.
+        let clamp = Rect::new(pad.x + 3, pad.y.saturating_sub(1), pad.width - 6, 3);
+        cr_fill(buf, clamp, body);
+        cr_frame(buf, clamp, edge, body, true);
+        cr_put(buf, clamp.x + 2, clamp.y + 1, "▟ LEECH ▙", edge, body, true);
+        let led = match self.state {
+            CrackState::Cracked => cr_rgb(80, 255, 140),
+            CrackState::Run => cr_rgb(255, 180, 40),
+            _ => cr_rgb(255, 40, 60),
+        };
+        cr_put(buf, clamp.right() - 3, clamp.y + 1, "●", led, body, false);
+        for dx in [4u16, 9, 14] {
+            cr_put(buf, clamp.x + dx, clamp.bottom(), "╽", edge, cr_rgb(40, 46, 54), false);
+        }
+        // The pad's own glass, taken over.
+        let inner = Rect::new(pad.x + 3, pad.y + 4, pad.width - 6, 2);
+        cr_fill(buf, inner, glass_bg);
+        self.bar_caps(buf, inner.x, inner.y, dim, on, cr_rgb(255, 255, 255), glass_bg, false);
+        cr_put(buf, inner.x + 1, inner.y + 1, &self.digits(), on, glass_bg, true);
+        if self.state == CrackState::Miss {
+            cr_put(buf, inner.x + 9, inner.y + 1, "ERR", cr_rgb(255, 40, 60), glass_bg, true);
+        }
+        self.leds(buf, inner.x + 14, inner.y + 1, cr_rgb(255, 40, 60), cr_rgb(70, 20, 30), glass_bg);
+    }
+
+    fn scope(&self, buf: &mut Buffer, pad: Rect) {
+        let body = cr_rgb(38, 32, 24);
+        let edge = cr_rgb(255, 170, 40);
+        let ph = cr_rgb(18, 11, 2);
+        let hot = cr_rgb(255, 196, 70);
+        let dim = cr_rgb(95, 58, 12);
+        let r = Rect::new(pad.right() + 3, pad.y + 1, 28, 15);
+        for y in [r.y + 5, r.y + 6] {
+            for x in pad.right()..r.x {
+                cr_put(buf, x, y, "─", cr_rgb(150, 100, 20), cr_rgb(10, 8, 6), false);
+            }
+        }
+        cr_put(buf, pad.right() - 1, r.y + 5, "┥", edge, cr_rgb(40, 46, 54), true);
+        cr_put(buf, pad.right() - 1, r.y + 6, "┥", edge, cr_rgb(40, 46, 54), true);
+        cr_fill(buf, r, body);
+        cr_frame(buf, r, edge, body, true);
+        cr_put(buf, r.x + 2, r.y + 1, "TUMBLER", edge, body, true);
+        cr_put(buf, r.x + 10, r.y + 1, "T9 · pin scope", cr_rgb(170, 140, 90), body, false);
+        // The trace: a hum across the pad's lines, the true pin a hot window.
+        let screen = Rect::new(r.x + 2, r.y + 3, r.width - 4, 6);
+        cr_fill(buf, screen, ph);
+        let (at, w) = CR_ZONES[self.beat()];
+        let cols = screen.width - 2;
+        let levels = ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"];
+        for c in 0..cols {
+            let bar_i = c * CR_BAR / cols;
+            let in_zone = bar_i >= at && bar_i < at + w;
+            let t = c as f32 / cols as f32 * 12.0 + self.found as f32;
+            let base = ((t.sin() * 0.5 + 0.5) * 9.0) as i32 + 2;
+            let h = if in_zone { 22 } else { base };
+            let marker = bar_i == self.marker && self.state == CrackState::Run;
+            let miss = self.state == CrackState::Miss;
+            let fg = if marker {
+                cr_rgb(255, 255, 240)
+            } else if in_zone && miss {
+                cr_rgb(255, 40, 60)
+            } else if in_zone {
+                hot
+            } else {
+                dim
+            };
+            let bg = if marker { cr_rgb(80, 60, 20) } else { ph };
+            for row in 0..3i32 {
+                let y = screen.y + 4 - row as u16;
+                let fill = (h - row * 8).clamp(0, 8);
+                let ch = if fill == 0 { " " } else { levels[(fill - 1) as usize] };
+                cr_put(buf, screen.x + 1 + c, y, ch, fg, bg, false);
+            }
+        }
+        cr_put(buf, screen.x + 1, screen.y, "PIN", dim, ph, false);
+        cr_put(buf, screen.x + 5, screen.y, &format!("{}", (self.found + 1).min(4)), hot, ph, true);
+        if self.state == CrackState::Miss {
+            cr_put(buf, screen.right() - 6, screen.y, "SLIP", cr_rgb(255, 40, 60), ph, true);
+        }
+        cr_put(buf, r.x + 2, r.y + 10, "CODE", cr_rgb(170, 140, 90), body, false);
+        cr_put(buf, r.x + 7, r.y + 10, &self.digits(), hot, body, true);
+        cr_put(buf, r.x + 15, r.y + 10, "SLIPS", cr_rgb(170, 140, 90), body, false);
+        self.leds(buf, r.x + 21, r.y + 10, cr_rgb(255, 40, 60), cr_rgb(70, 30, 20), body);
+        cr_put(buf, r.x + 2, r.y + 12, "space", edge, body, true);
+        cr_put(buf, r.x + 8, r.y + 12, "catch the pin", cr_rgb(170, 140, 90), body, false);
+        cr_put(buf, r.x + 2, r.y + 13, "esc", edge, body, true);
+        cr_put(buf, r.x + 8, r.y + 13, "unclip", cr_rgb(170, 140, 90), body, false);
+    }
+}
+
+impl Screen for MockCracker {
+    fn update(&mut self, _: &mut AppState, _: &[crossterm::event::KeyEvent]) -> crate::app::ScreenCmd {
+        crate::app::ScreenCmd::Stay
+    }
+    fn draw(&self, st: &AppState, f: &mut ratatui::Frame) {
+        self.pad.draw(st, f);
+        let area = f.area();
+        let w = crate::ui::device::DEVICE_W.min(area.width);
+        let h = crate::ui::device::DEVICE_H.min(area.height);
+        let pad = Rect::new(
+            area.x + area.width.saturating_sub(w) / 2,
+            area.y + area.height.saturating_sub(h) / 2,
+            w,
+            h,
+        );
+        let buf = f.buffer_mut();
+        match self.look {
+            CrackLook::Slab => self.slab(buf, pad),
+            CrackLook::Leech => self.leech(buf, pad),
+            CrackLook::Scope => self.scope(buf, pad),
+        }
+    }
+}
+
+#[test]
+#[ignore]
+fn cracker_mock() {
+    let frames: [(&str, CrackLook, CrackState, usize, u8, u16, Option<bool>); 9] = [
+        ("a_beat1", CrackLook::Slab, CrackState::Run, 0, 0, 3, None),
+        ("a_beat4", CrackLook::Slab, CrackState::Run, 3, 1, 10, None),
+        ("a_miss", CrackLook::Slab, CrackState::Miss, 2, 2, 0, None),
+        ("a_fried", CrackLook::Slab, CrackState::Fried, 2, 3, 0, Some(false)),
+        ("a_cracked", CrackLook::Slab, CrackState::Cracked, 4, 1, 0, Some(true)),
+        ("b_beat3", CrackLook::Leech, CrackState::Run, 2, 1, 8, None),
+        ("b_miss", CrackLook::Leech, CrackState::Miss, 1, 2, 0, None),
+        ("c_beat2", CrackLook::Scope, CrackState::Run, 1, 0, 6, None),
+        ("c_beat4", CrackLook::Scope, CrackState::Run, 3, 2, 15, None),
+    ];
+    for (name, look, state, found, misses, marker, verdict) in frames {
+        for (w, h) in [(120u16, 40u16), (100, 30)] {
+            let mut st = state_home();
+            let map = MapScreen::walking(&mut st);
+            crate::jobs::first_favour(&mut st);
+            st.tick += 200;
+            let (b, level, number, _) = crate::jobs::first_fetch(&st).expect("the favour");
+            let seed = st.city.as_ref().unwrap().seed;
+            let code = citygen::rng::door_code(seed, b, level, number);
+            let digits = [
+                (code / 1000 % 10) as u8,
+                (code / 100 % 10) as u8,
+                (code / 10 % 10) as u8,
+                (code % 10) as u8,
+            ];
+            let mut pad = Keypad::open(&st, b, level, number);
+            for d in digits.iter().take(found) {
+                pad.show_digit(*d);
+            }
+            if let Some(open) = verdict {
+                pad.show_verdict(open, st.tick);
+            }
+            let cracker = MockCracker {
+                pad,
+                look,
+                state,
+                code: digits,
+                found,
+                misses,
+                marker,
+            };
+            shot_stack(
+                &format!("crack_{name}_{w}x{h}"),
+                &st,
+                &[&map, &cracker],
+                (w, h),
+            );
+        }
+    }
+}
