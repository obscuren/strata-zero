+/// MOCK: clear objectives, the JOBS list without walk lines, and the mail mark.
+#[test]
+#[ignore]
+fn objectives_mock() {
+    use crate::missions::RunState;
+    use crate::screens::jobs_tab::Entry;
+    use std::sync::atomic::Ordering;
+    let idx = |st: &AppState, id: &str| st.book.missions.iter().position(|m| m.id == id).unwrap();
+    let deck_on = |st: &mut AppState, want: &Entry| {
+        let mut deck = Deck::new(st.tick);
+        deck.update(st, &[key(KeyCode::Char('5'))]);
+        deck.jobs.select(st, want);
+        st.tick += 200;
+        while st.tick % 90 < 3 {
+            st.tick += 1;
+        }
+        deck
+    };
+    let set = |st: &mut AppState, id: &str, state: RunState, objectives: &[&str]| {
+        let i = st.book.missions.iter().position(|m| m.id == id).unwrap();
+        let run = &mut st.missions.runs[i];
+        run.state = state;
+        run.objectives = objectives.iter().map(|s| s.to_string()).collect();
+    };
+    let done = RunState::Done { at: 0 };
+    for (w, h) in [(120u16, 40u16), (100, 30)] {
+        let size = (w, h);
+        let name = |what: &str| format!("mock_{what}_{w}x{h}");
+
+        // The JOBS tab, the morning after mid-chain, the doctor open beside it.
+        let mut st = seren_has_written();
+        st.missions.daze = None;
+        st.missions.asides.clear();
+        let ids = crate::jobs::testutil::six_jobs(&mut st);
+        set(&mut st, "morning_after", RunState::Open, &[
+            "Catch the news on the holo",
+            "Read Mezz's mail",
+            "Open the package · it's in your pack",
+        ]);
+        let map = by_the_set(&mut st);
+        let m = idx(&st, "morning_after");
+        let deck = deck_on(&mut st, &Entry::Mission(m));
+        shot_stack(&name("jobs_morning"), &st, &[&map, &deck], size);
+        let deck = deck_on(&mut st, &Entry::Job(ids[0]));
+        shot_stack(&name("jobs_job"), &st, &[&map, &deck], size);
+
+        // The ledger, its first objective fit to a hacker.
+        set(&mut st, "morning_after", done, &[
+            "Catch the news on the holo",
+            "Read Mezz's mail",
+            "Open the package · it's in your pack",
+        ]);
+        set(&mut st, "ledger", RunState::Open, &[
+            "Find out whose shard this is · read it at your rig",
+        ]);
+        let l = idx(&st, "ledger");
+        let deck = deck_on(&mut st, &Entry::Mission(l));
+        shot_stack(&name("jobs_ledger"), &st, &[&map, &deck], size);
+
+        // The main screen as Mezz's mail lands: three marks.
+        let mut st = seren_has_written();
+        st.missions.daze = None;
+        st.missions.asides.clear();
+        let d = idx(&st, "doctor");
+        st.missions.runs[d].state = RunState::Waiting;
+        set(&mut st, "morning_after", RunState::Open, &[
+            "Catch the news on the holo",
+            "Read Mezz's mail",
+        ]);
+        for m in st.journal.mails.iter_mut() {
+            m.read = m.subject != "the news";
+        }
+        st.story("`Mezz` · mail · the news".to_string());
+        st.tick += 120;
+        st.tick = st.clock_tick() + 120;
+        let map = by_the_set(&mut st);
+        world_seconds(&mut st, 3);
+        for (k, opt) in [(1u8, "a"), (2, "b"), (3, "c")] {
+            crate::ui::hud::MOCK_MAIL.store(k, Ordering::Relaxed);
+            crate::ui::hud::MOCK_FRESH.store(true, Ordering::Relaxed);
+            shot_stack(&name(&format!("mail_{opt}")), &st, &[&map], size);
+            crate::ui::hud::MOCK_FRESH.store(false, Ordering::Relaxed);
+            shot_stack(&name(&format!("mail_{opt}_settled")), &st, &[&map], size);
+        }
+        crate::ui::hud::MOCK_MAIL.store(1, Ordering::Relaxed);
+        crate::ui::hud::MOCK_FRESH.store(false, Ordering::Relaxed);
+
+        // At the rig: the mail row, then the mail opened.
+        let home = st.home.unwrap().home;
+        let floor = st
+            .interiors
+            .floor(home.building, home.level)
+            .map(|(_, f)| f.clone())
+            .unwrap();
+        st.player.as_mut().unwrap().pos = home
+            .rig
+            .neighbors4()
+            .find(|p| home.rect.contains(*p) && floor.tiles.get(*p).is_some_and(|t| t.is_walkable()))
+            .expect("a floor tile by the rig");
+        let map = MapScreen::walking(&mut st);
+        st.tick += 200;
+        let rig = crate::interact::gather(&st, &|_, _| None)
+            .into_iter()
+            .find(|s| s.header.as_ref().is_some_and(|h| h.name == "Access rig"))
