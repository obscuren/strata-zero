 /// ` DEV  VEX :: LVL 2 :: ¤ 320 [:: seed N :: F fps]`, cut to `width`.
+/// MOCK: which mail mark the screen draws: 0 none, 1 A (status line), 2 B (band row),
+/// 3 C (a pill on the map).
+pub static MOCK_MAIL: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+/// MOCK: the mail just landed (the mark lit) or has sat a while.
+pub static MOCK_FRESH: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+/// MOCK: the unread mail: how many, and the newest's sender and subject.
+pub fn mock_unread(mails: &[crate::credentials::Mail]) -> Option<(usize, String, String)> {
+    let n = mails.iter().filter(|m| !m.read).count();
+    let m = mails.iter().rev().find(|m| !m.read)?;
+    Some((n, m.from.clone(), m.subject.clone()))
+}
+
+pub fn mock_option() -> u8 {
+    MOCK_MAIL.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+pub fn mock_fresh() -> bool {
+    MOCK_FRESH.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+fn mock_words(n: usize) -> String {
+    if n == 1 { "NEW MAIL".to_string() } else { format!("{n} NEW MAIL") }
+}
+
+/// MOCK A: the mark on the status line, after the credits.
+pub fn mock_status_mark(unread: &Option<(usize, String, String)>) -> Vec<Span<'static>> {
+    let Some((n, _, _)) = unread else {
+        return Vec::new();
+    };
+    let words = mock_words(*n);
+    let style = if mock_fresh() {
+        Style::default()
+            .fg(BADGE_FG)
+            .bg(crate::ui::chrome::MAGENTA)
+            .add_modifier(Modifier::BOLD)
+    } else {
+        Style::default()
+            .fg(crate::ui::chrome::MAGENTA)
+            .add_modifier(Modifier::BOLD)
+    };
+    vec![dim(" :: "), Span::styled(format!(" ▣ {words} "), style)]
+}
+
+/// MOCK B: the mark at the right end of the band's third row: who wrote and about what.
+pub fn mock_band_mark(unread: &Option<(usize, String, String)>, width: u16) -> Line<'static> {
+    let Some((n, from, subject)) = unread else {
+        return Line::from("");
+    };
+    let more = if *n > 1 { format!(" +{}", n - 1) } else { String::new() };
+    let text = format!("▣ {from} · {subject}{more} ");
+    let style = if mock_fresh() {
+        Style::default()
+            .fg(BADGE_FG)
+            .bg(crate::ui::chrome::MAGENTA)
+            .add_modifier(Modifier::BOLD)
+    } else {
+        Style::default()
+            .fg(crate::ui::chrome::MAGENTA)
+            .add_modifier(Modifier::BOLD)
+    };
+    let w = text.chars().count() + 1;
+    let gap = (width as usize).saturating_sub(w);
+    Line::from(vec![Span::raw(" ".repeat(gap)), Span::styled(format!(" {text}"), style)])
+}
+
+/// MOCK C: a pill on the map's top edge, right: what landed and from whom.
+pub fn mock_pill(unread: &Option<(usize, String, String)>) -> Option<Line<'static>> {
+    let (n, from, subject) = unread.as_ref()?;
+    let more = if *n > 1 { format!("  +{}", n - 1) } else { String::new() };
+    let lit = Style::default()
+        .fg(BADGE_FG)
+        .bg(crate::ui::chrome::MAGENTA)
+        .add_modifier(Modifier::BOLD);
+    let soft = Style::default()
+        .fg(Color::Rgb(255, 225, 245))
+        .bg(Color::Rgb(120, 20, 90));
+    Some(Line::from(vec![
+        Span::styled(" ▣ MAIL ", lit),
+        Span::styled(format!(" {} · {subject}{more} ", from.to_uppercase()), soft),
+    ]))
+}
