+        let mut pop = rig.window(st.tick.saturating_sub(200));
+        shot_stack(&name("rig"), &st, &[&map, &pop], size);
+        pop.update(&mut st, &[key(KeyCode::Char('m'))]);
+        st.tick += 200;
+        shot_stack(&name("rig_mail"), &st, &[&map, &pop], size);
+    }
+    crate::ui::hud::MOCK_MAIL.store(0, Ordering::Relaxed);
+}
