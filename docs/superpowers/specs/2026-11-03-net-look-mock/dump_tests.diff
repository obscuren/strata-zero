+// THROWAWAY (net mockups): a black-ICE construct as it is, and a dump of it.
+#[test]
+#[ignore]
+fn tmp_construct_look() {
+    use citygen::{Feature, NodeKind, SubnetOwner, Terrain};
+    let Ok(dir) = std::env::var("SHOT_DIR") else {
+        return;
+    };
+    let mut st = state_home();
+    let mut map = MapScreen::walking(&mut st);
+    let city = st.city.clone().unwrap();
+    let sec = |b: citygen::BuildingId| {
+        city.net
+            .subnets
+            .iter()
+            .find(|s| s.owner == SubnetOwner::Building(b))
+            .map_or(0, |s| s.security)
+    };
+    let (k, b) = city
+        .buildings
+        .iter()
+        .filter(|b| sec(b.id) >= 230)
+        .filter_map(|b| citygen::construct::generate_construct(&city, b.id).map(|k| (k, b.id)))
+        .filter(|(k, _)| k.size.w <= 40 && k.size.h <= 22 && k.vault_room().is_some())
+        .max_by_key(|(k, _)| (k.rooms.len(), k.size.w * k.size.h))
+        .expect("a black construct with a vault");
+    let name = city.building(b).name.clone().unwrap_or_default();
+    {
+        let p = st.player.as_mut().unwrap();
+        p.body = Some((p.place, p.pos));
+        p.place = Place::Stratum(StratumKind::Net);
+        p.pos = crate::constructs::city_gate(&city, b).unwrap();
+    }
+    crate::constructs::enter_construct(&mut st, b).unwrap();
+    map.place = Place::Construct(b);
+    let here = st.player.as_ref().unwrap().pos;
+    map.cam.snap(here);
+    map.update(&mut st, &[]);
+    let shot = |st: &AppState, map: &MapScreen, name: &str| {
+        write_svg(&dir, name, st, &draw_stack(st, &[map], (120, 40)), false);
+    };
+    shot(&st, &map, "construct_now");
+    {
+        let p = st.player.as_mut().unwrap();
+        for y in 0..k.size.h as i32 {
+            for x in 0..k.size.w as i32 {
+                p.set_vis(Pos::new(x, y), crate::render::Visibility::Visible);
+            }
+        }
+    }
+    shot(&st, &map, "construct_all_visible");
+    let mut rows = Vec::new();
+    for y in 0..k.size.h as i32 {
+        let mut r = String::new();
+        for x in 0..k.size.w as i32 {
+            let t = &k.tiles[Pos::new(x, y)];
+            r.push(match (t.terrain, t.feature) {
+                (_, Some(Feature::Ice(_))) => 'I',
+                (_, Some(Feature::Node(NodeKind::DataVault))) => 'V',
+                (_, Some(Feature::Node(NodeKind::Server))) => 'S',
+                (_, Some(Feature::Node(NodeKind::Terminal))) => 'T',
+                (_, Some(Feature::Node(NodeKind::DoorLock))) => 'D',
+                (_, Some(Feature::Node(NodeKind::Camera))) => 'C',
+                (_, Some(Feature::Node(NodeKind::LiftCtrl))) => 'U',
+                (_, Some(Feature::Node(_))) => 'N',
+                (Terrain::NetWall, _) => 'W',
+                (Terrain::NetFloor, _) => 'F',
+                (Terrain::NetLane, _) => 'L',
+                (Terrain::NetGate, _) => 'G',
+                _ => '?',
+            });
+        }
+        rows.push(format!("{r:?}"));
+    }
+    let guards: Vec<String> = k
+        .guards
+        .iter()
+        .map(|g| {
+            format!(
+                "{{\"x\":{},\"y\":{},\"grade\":\"{}\",\"beat\":[{}]}}",
+                g.pos.x,
+                g.pos.y,
+                g.grade.label(),
+                g.beat
+                    .iter()
+                    .map(|p| format!("[{},{}]", p.x, p.y))
+                    .collect::<Vec<_>>()
+                    .join(",")
+            )
+        })
+        .collect();
+    let rooms: Vec<String> = k
+        .rooms
+        .iter()
+        .map(|r| format!("[{},{},{},{}]", r.x, r.y, r.w, r.h))
+        .collect();
+    let json = format!(
+        "{{\"name\":{:?},\"sec\":{},\"w\":{},\"h\":{},\"entry\":[{},{}],\"you\":[{},{}],\"rows\":[{}],\"guards\":[{}],\"rooms\":[{}]}}",
+        name,
+        k.security,
+        k.size.w,
+        k.size.h,
+        k.entry.x,
+        k.entry.y,
+        here.x,
+        here.y,
+        rows.join(","),
+        guards.join(","),
+        rooms.join(",")
+    );
+    std::fs::write(format!("{dir}/construct_dump.json"), json).unwrap();
+}
