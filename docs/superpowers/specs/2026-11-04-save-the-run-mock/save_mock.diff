+/// Throwaway (the save spike): how big and how slow the city is in each format.
+#[test]
+#[ignore]
+fn save_spike_sizes() {
+    use std::io::Write as _;
+    use std::time::Instant;
+    let st = state_home();
+    let city = st.city.as_ref().unwrap();
+    let t = Instant::now();
+    let pc = postcard::to_allocvec(city).unwrap();
+    let pc_t = t.elapsed();
+    let t = Instant::now();
+    let mp = rmp_serde::to_vec_named(city).unwrap();
+    let mp_t = t.elapsed();
+    let t = Instant::now();
+    let mut gz = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::fast());
+    gz.write_all(&mp).unwrap();
+    let gz = gz.finish().unwrap();
+    let gz_t = t.elapsed();
+    let t = Instant::now();
+    let back: citygen::City = rmp_serde::from_slice(&mp).unwrap();
+    let de_t = t.elapsed();
+    assert_eq!(back.seed, city.seed);
+    let t = Instant::now();
+    let mut d = flate2::read::GzDecoder::new(&gz[..]);
+    let mut raw = Vec::new();
+    std::io::Read::read_to_end(&mut d, &mut raw).unwrap();
+    let un_t = t.elapsed();
+    eprintln!(
+        "postcard {} B {:?} · msgpack named {} B {:?} · gz fast {} B {:?} · de {:?} · gunzip {:?}",
+        pc.len(),
+        pc_t,
+        mp.len(),
+        mp_t,
+        gz.len(),
+        gz_t,
+        de_t,
+        un_t
+    );
+}
