+/// Throwaway (the save mock): the title, the load list, the pause menu over the map and
+/// the flatline, as they draw today.
+#[test]
+#[ignore]
+fn save_mock_frames() {
+    let Ok(dir) = std::env::var("SHOT_DIR") else {
+        return;
+    };
+    let mut st = AppState::new();
+    let mut title = crate::screens::initial(&st);
+    for _ in 0..90 {
+        st.tick += 1;
+        title.update(&mut st, &[]);
+    }
+    write_svg(&dir, "save_title", &st, &draw_stack(&st, &[&title], (120, 40)), false);
+
+    let mut st = state_home();
+    let saves = std::path::PathBuf::from(&dir).join("cities");
+    std::fs::create_dir_all(&saves).unwrap();
+    for name in ["Lowport", "Chromespire"] {
+        crate::save::save_city(&saves.join(format!("{name}.city")), st.city.as_ref().unwrap())
+            .unwrap();
+    }
+    let files = crate::screens::files::Files::load_in(saves, st.tick);
+    write_svg(&dir, "save_files", &st, &draw_stack(&st, &[&files], (120, 40)), false);
+
+    let mut map = MapScreen::walking(&mut st);
+    for _ in 0..30 {
+        st.tick += 1;
+        map.update(&mut st, &[]);
+    }
+    let pause = crate::screens::pause::Pause::new(st.tick);
+    st.tick += 30;
+    write_svg(&dir, "save_pause", &st, &draw_stack(&st, &[&map, &pause], (120, 40)), false);
+    write_svg(&dir, "save_map", &st, &draw_stack(&st, &[&map], (120, 40)), false);
+
+    let flat = crate::screens::flatlined::Flatlined::new(
+        "black ICE · the bank's vault".to_string(),
+        &st.character.handle,
+        st.character.level,
+        st.tick,
+    );
+    st.tick += 90;
+    write_svg(&dir, "save_flatlined", &st, &draw_stack(&st, &[&flat], (120, 40)), false);
+}
