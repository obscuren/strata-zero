+/// A reading card: a HOLO bracket box over whatever is under it, its lines as given.
+struct MockRead {
+    head: (&'static str, &'static str),
+    lines: Vec<Vec<(String, Color, bool)>>,
+    close: &'static str,
+}
+
+impl Screen for MockRead {
+    fn update(&mut self, _: &mut AppState, _: &[crossterm::event::KeyEvent]) -> crate::app::ScreenCmd {
+        crate::app::ScreenCmd::Stay
+    }
+    fn draw(&self, st: &AppState, f: &mut ratatui::Frame) {
+        use ratatui::style::Style;
+        const MAGENTA: Color = Color::Rgb(255, 0, 200);
+        const DIM: Color = Color::Rgb(110, 120, 135);
+        let area = f.area();
+        let w = 66u16.min(area.width - 4);
+        let h = (self.lines.len() as u16 + 7).min(area.height - 2);
+        let r = Rect::new(area.x + (area.width - w) / 2, area.y + (area.height - h) / 2 - 2, w, h);
+        let buf = f.buffer_mut();
+        crate::missions::face::bracket_frame(buf, r);
+        let put = |buf: &mut Buffer, x: u16, y: u16, s: &str, c: Color, b: bool| {
+            let mut style = Style::default().fg(c).bg(Color::Rgb(10, 12, 18));
+            if b {
+                style = style.add_modifier(Modifier::BOLD);
+            }
+            buf.set_string(x, y, s, style);
+        };
+        put(buf, r.x + 3, r.y + 1, self.head.0, MAGENTA, true);
+        put(buf, r.x + 4 + self.head.0.chars().count() as u16, r.y + 1, self.head.1, DIM, false);
+        let (hh, mm) = st.clock();
+        put(buf, r.right() - 16, r.y + 1, "▂▄▆█", MAGENTA, false);
+        put(buf, r.right() - 11, r.y + 1, &format!("{hh:02}:{mm:02}"), DIM, false);
+        for (j, line) in self.lines.iter().enumerate() {
+            let mut x = r.x + 3;
+            for (s, c, b) in line {
+                put(buf, x, r.y + 3 + j as u16, s, *c, *b);
+                x += s.chars().count() as u16;
+            }
+        }
+        let ky = r.bottom() - 2;
+        put(buf, r.x + 3, ky, "space", MAGENTA, true);
+        put(buf, r.x + 9, ky, self.close, DIM, false);
+    }
+}
+
+fn seg(s: &str, c: Color) -> (String, Color, bool) {
+    (s.to_string(), c, false)
+}
+fn segb(s: &str, c: Color) -> (String, Color, bool) {
+    (s.to_string(), c, true)
+}
